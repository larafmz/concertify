%div{ class: "widget-content", style: "background: #1f252b;"}
    %div{ class: "artist-content", style: "background: #1f252b;"}
        .artist-info
            .user_icon
                = image_tag  @user.icon, class: "artist-avatar" if @user.icon.attached?
                
            .artist-name
                %div{style: "margin-bottom:5px; font-size:25px;"}= @user.username
                - if current_user.id == @user.id
                    = link_to t("crud.edit", model: t("profile")), edit_user_path(current_user.id), class: "small-btn-custom"
                - if @user.ubication
                    .soft-color{style: "font-size: 15px;" } 
                        📍 #{@user.ubication.complete_name}
              
        .flex
            .stat
                .number
                    = @user.registers.size
                .name
                    = link_to diary_user_path(@user) do
                        = Concert.plural
            
            .stat
                .number
                    = @user.registers.joins(:concert).where("EXTRACT(YEAR FROM concerts.date) = ?", Date.current.year).size
                .name
                    = link_to registers_user_path(@user) do
                        = t("this_year")
            .stat
                .number
                    = @user.followings.users.size
                .name
                    = link_to followings_user_path(@user) do
                        = t("following")                            
            .stat
                .number
                    = @user.followers.users.size
                .name
                    = link_to followers_user_path(@user) do
                        = t("followers")
                            

    %div{style: "display:flex; align-items:center; gap:8px; padding-top: 10px;"}

        - if current_user && current_user.id!=@user.id
            .soft-color{ style: "margin-left: auto; background: #1f252b;"}
                - if current_user.blocked_user?(@user.id)
                    .red-message
                        =User.singular.upcase
                        =t("blocked").upcase
                - else
                    - if current_user.follows_user?(@user.id)
                        = link_to t("following"), unfollow_user_path(@user.id), class: "btn-standard", data: { turbo_method: :delete }
                    - else
                        = link_to t("verbs.follow"), follow_user_path(@user.id), class: "btn-standard-orange", data: { turbo_method: :post }
                    - if @user.follows_user?(current_user.id)   
                        %span{style: "margin-left: 10px;"}= t("follows_you")


            .dropdown
                .dropdown-toggle{
                    "data-bs-toggle" => "dropdown",
                    style: "color: white" 
                }
                    ⁝
                %ul.dropdown-menu
                    %li
                        - if current_user.blocked_user?(@user.id)
                            = link_to t("verbs.unblock"), unblock_user_path(@user.id), class: "dropdown-item", data: { turbo_method: :delete }
                        - else
                            = link_to t("verbs.block"), block_user_path(@user.id), class: "dropdown-item", data: { turbo_method: :post }
                    - if @user.follows_user?(current_user.id)
                        %li
                            %hr.dropdown-divider     
                        %li
                            = link_to t("crud-delete", model: t("follower")), unfollow_user_path(follower_id: user.id), class: "dropdown-item", data: { turbo_method: :delete }

.separator{style: "background: #40556d; "}

