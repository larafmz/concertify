%div{id: "like-interactuable-#{interactuable.id}", style: "display: flex; align-items: center"}
    - if can?(:like, interactuable)
        = button_to like_interactuable_path(interactuable), method: :post, class: "button-without-format", id:"like_interactuable_#{interactuable.id}" do
            - unless current_user.liked?(interactuable.id)
                %i.fa-regular.fa-heart, id: "image_like_#{interactuable.id}"
            - else
                %span{id: "image_liked_#{interactuable.id}", style: "color: #{orange_color}; "}
                    %i.fa-solid.fa-heart

    - else
        %i.fa-regular.fa-heart, id: "image_like_#{interactuable.id}"
        
    - if interactuable.likes.count != 0
        = link_to interactuable_path(interactuable) do 
            %span{id: "like_count_#{interactuable.id}"}= interactuable.likes.count