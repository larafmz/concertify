- if @comment.interactuable.publication?
    = render "users/options", active: :publications
- elsif @comment.interactuable.register?
    = render "users/options", active: :reviews

.widget-content{style: "padding-top:0px;"}  

    .event_tag
        = link_to "<-", father_link(@comment)

    %div{style: "border: 1px solid var(--second-text-color);"}

        %div{style: "margin:20px; margin-bottom:0px;"}
            = render "comments/show", comment: @comment

        %div{style: "display: flex; color: var(--main-text-color); margin-left:20px; "}
            = Comment.plural
        .separator

        - if can?(:reply, @comment)
            %div{style: "border-bottom: 1px solid var(--second-text-color);"}
                = form_tag reply_comment_path(@comment), method: :post, data: { turbo: false } do
                    %div{data: { controller: "character-counter" }, style: "margin:15px; display: grid; grid-template-columns: auto 1fr auto; color: var(--main-text-color); gap: 10px; "}
                        %div
                            = link_to user_path(current_user), class: "hover-border-icon",style: "display: block;" do 
                                .link_icon{style: "background: var(--darker-second-text-color);"}
                                    - if current_user.icon.attached?
                                        = image_tag current_user.icon
                                    - else
                                        = current_user.username.first.upcase
                        = text_area_tag :text, nil, maxlength: 500, placeholder: t("messages.write_your_answer"), style: "outline:none; color: var(--main-text-color); border: none; background:none; width: 100%; height: 50px; resize: none;", data: {  character_counter_target: "input", action: "input->character-counter#update" }
                        %div{data: { character_counter_target: "counter" }, style: "text-align: right; font-size: 12px; color: var(--soft-color);"}
                    %div{style: "display: flex; justify-content: flex-end; margin: 10px;"}
                        = submit_tag t("verbs.answer"), class: "btn-custom orange-color"

        - @replies.each do |comment|
            = render "comments/show", comment: comment
            
        .separator