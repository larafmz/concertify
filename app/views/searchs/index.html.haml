.widget-content.list

  - if (!params[:first_date] && !params[:second_date] && !params[:country]) || (params[:first_date].empty? && params[:second_date].empty? && params[:country].empty?)
    .section-box
      %h2 USUARIOS • #{@users.size} RESULTADOS
      .items
        - @users.each do |user|
          .item-name
            = user.email

  .section-box
    %h2 ARTISTAS • #{@artists.size + @artists_db.size} RESULTADOS
    .items
      - @artists[0..9].each do |artist|
        = link_to artist_path(id: "ticketmaster", ticketmaster_id: artist.dig("id")) do
          .item 
            .rectangle_icon
              = image_tag best_quality_image(artist.dig("images")).dig("url"), class: "artist-avatar"
            .item-name
              = artist.dig("name")
      - @artists_db[0..9].each do |artist|
        = link_to artist_path(artist.id) do
          .item 
            .rectangle_icon
              = image_tag artist.photo, class: "artist-avatar"
            .item-name
              = artist.name


  .section-box
    - concerts_size = @concerts_api.size + @concerts_db.size
    - if concerts_size > 100
      %h2 CONCIERTOS + 100 RESULTADOS
    - else 
      %h2 CONCIERTOS • #{concerts_size} RESULTADOS
    = render "searchs/filters"
    .concerts-items
      = render "concerts/index_db", concerts: @concerts_db.first(10)
      = render "concerts/index_api", concerts: @concerts_api.first(10)
          
