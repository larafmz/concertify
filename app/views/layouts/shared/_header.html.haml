.header
  .app_name
    = link_to root_path do
      = image_tag("concertify_logo_mix.png")


  - search_path = %w[artists users events].include?(controller_name) ? "/#{controller_name}" : "/artists"
  = form_tag search_path, method: "GET" do
    = text_field_tag :search, params[:search], placeholder: "🔍 #{t("main_search")}", class: "field-custom"

  %div
    %div{style: "display: flex; gap: 10px; align-items: center;"}
      .dropdown
        %button.btn.btn-secondary.dropdown-toggle{
          type: "button",
          "data-bs-toggle" => "dropdown",
          "aria-expanded" => "false",
          style: "background: #{orange_color}" 
        }
          =t("crud.show", model: "")

        %ul.dropdown-menu
          %li
            = link_to Event.plural, events_path, class: "dropdown-item"
          %li
            = link_to Register.plural, registers_path, class: "dropdown-item"
          %li
            = link_to Publication.plural, publications_path, class: "dropdown-item"
          %li
            = link_to Artist.plural, artists_path, class: "dropdown-item"
          %li
            = link_to User.plural, users_path, class: "dropdown-item"

      - if can?(:create, Publication)
        = link_to new_publication_path, class: "btn-standard", data: { turbo_frame: "modal" } do
          = image_tag("icon_post.png", style: "width: 75%; height: 75%")


      - if can?(:read, Request)
        .dropdown
          %button.btn.btn-secondary.dropdown-toggle{
            type: "button",
            "data-bs-toggle" => "dropdown",
            "aria-expanded" => "false",
            style: "background: #{orange_color}" 
          }
            =t("admin")

          %ul.dropdown-menu
            %li
              = link_to t("requested_events"), requests_path, class: "dropdown-item"            


  - if current_user
    .flex{style: "display: flex; justify-content: right; gap: 30px; padding: 10px; font-size: 18px; color: white; "}
      = link_to user_path(current_user), class: "hover-border-icon", title: t("user_account.profile") do
        .link_icon
          - if current_page?(user_path(current_user))
            = image_tag("icon_user_selected.png", style: "width: 75%; height: 75%")
          - else
            = image_tag("icon_user.png", style: "width: 75%; height: 75%")
      = link_to notifications_user_path(current_user), class: "hover-border-icon", title: Notification.plural do
        = render "layouts/shared/notifications_bubble"
      = link_to chats_path, class: "hover-border-icon", title: Chat.plural do
        = render "layouts/shared/messages_bubble"

  .dropdown
    %button.btn.btn-secondary.dropdown-toggle{
      type: "button",
      "data-bs-toggle" => "dropdown",
      "aria-expanded" => "false",
      style: "background: #51485a" 
    }
      = t("user_account.profile")

    %ul.dropdown-menu
      
      - if current_user
        %li 
          = link_to t("user_account.my_profile"), user_path(current_user), class: "dropdown-item"
        %li
          = link_to t("crud.edit", model: t("user_account.profile")), edit_user_registration_path, class: "dropdown-item"
        %li
          %hr.dropdown-divider
        %li
          = link_to t("my_model_plural", model: Register.plural), registers_user_path(current_user), class: "dropdown-item"
        %li
          = link_to t("my_model_plural", model: FutureAssistance.plural), future_assistances_user_path(current_user), class: "dropdown-item"
        %li
          = link_to t("my_model_plural", model: Publication.plural), publications_user_path(current_user), class: "dropdown-item"
        %li
          = link_to t("my_model_plural", model: Request.plural), requests_user_path(current_user), class: "dropdown-item"
        %li
          %hr.dropdown-divider
        %li 
          = button_to t("user_account.logout"), destroy_user_session_path, method: :delete, form: { data: { turbo: false } }, class: "dropdown-item"
      - else
        %li
        = link_to t("user_account.login"), new_user_session_path, class: "dropdown-item"
        %li
        = link_to t("user_account.register"), new_user_registration_path, class: "dropdown-item"


  .dropdown
    %button.btn.btn-secondary.dropdown-toggle{
      type: "button",
      "data-bs-toggle" => "dropdown",
      "aria-expanded" => "false",
      style: "background: #51485a" 
    }
      =t("languages")

    %ul.dropdown-menu
      %li
        = link_to t("spanish"), change_locale_path(:es), class: "dropdown-item"
      %li
        = link_to t("english"), change_locale_path(:en), class: "dropdown-item"


.separator{style: "background: #40556d; "}
