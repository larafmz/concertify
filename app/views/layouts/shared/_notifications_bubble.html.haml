= turbo_stream_from current_user, "notifications_header"
%div{id: "notifications_header", style: "display:flex; flex-direction:column; align-items:center;"}
    .link_icon
        - if current_page?(notifications_user_path(current_user))
            = image_tag("icon_notification_selected.png")
        - else
            = image_tag("#{session[:theme]}/icon_notification.png")
    - unread_notis = current_user.notifications.unread.size
    - if unread_notis > 0
        .normal_notification{style: "width:18px; height:18px; border-radius:50%; background:var(--link); color: var(--background); display:flex; justify-content:center; align-items:center; font-size:13px; font-weight:bold; margin-top:-6px;"}
            = unread_notis

