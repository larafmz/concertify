
.widget-content{style: "padding-top:0px;"}  
    - if future_assistances.empty?
        = render "common/empty_list_message", model: FutureAssistance
    - else
        - future_assistances[0..10].each do |future_assistance|
            - event = future_assistance.event
            - event_date = event.date
            - event_date_status = time_status(event_date, event.start_time)

            .future_assistance{style: "margin:20px 0px 20px 0px;"}
                = link_to user_path(future_assistance.user), class: "hover-border-icon" do
                    .link_icon 
                        = image_tag future_assistance.user.icon if future_assistance.user.icon.attached?

                %div
                    .flex-left
                        .softest-color{style: "font-weight: 700"} #{FutureAssistance.singular} #{t("by")}
                        = link_to user_path(future_assistance.user) do 
                            %span{style: "font-weight: 700; color: white;"}=future_assistance.user.username.upcase
        
                    .flex-left
                        %div{style: "margin-top:10px;"}
                            - if future_assistance.event_seat_string || !future_assistance.event_seat_details.empty?
                                .bubble
                                    %span= "🎟️ #{future_assistance.event_seat_string}"
                                    %span{class: "softest-color"}= " · #{future_assistance.event_seat_details}"
                        
                        %div{style: "margin-top:10px;"}
                            - if future_assistance.from && !future_assistance.from.empty?
                                .bubble
                                    %span{style: "color: rgb(230, 230, 230);"}= "📍 #{FutureAssistance.human_attribute_name(:from)} #{future_assistance.from}"

                        %div{style: "margin-top:10px;"}
                            - if future_assistance.company_string && future_assistance.company!= 0
                                .bubble
                                    #{future_assistance.company_string}

            .separator{style: "margin-top:10px;"}


