= render "events/header"
= render "events/options", active: :artists
.widget-content{style: "padding-top:0px;"}
    - if @artists.empty?
        = render "common/empty_list_message", model: Artist
    - else
        .artists-list{style: "gap: 10px;"}
            - @artists.each do |artist|
                = render "artists/index_item", artist: artist

