= render "users/options", active: :future_assistances if @user

- if !@user
    %br

.widget-content{style: "padding-top:0px;"}  

    - if @concert
        %div{style: "margin-top: 20px;"}
            .soft-color{style: "font-size: 15px;" }
                = FutureAssistance.plural
                de

            %div{ style: "color: white; font-family: Georgia, 'Times New Roman', Times, serif; font-size: 25px;" }
                = link_to @concert.tour_name, concert_path( @concert.id)

            .softest-color{style: "font-size: 15px;" }
                %span= "📍#{@concert.ubication&.complete_name} 🗓️ #{short_date(@concert.date)}"

            %br
            .separator{style: "margin-bottom: 15px; "}

    = render "future_assistances/index", future_assistances: @future_assistances