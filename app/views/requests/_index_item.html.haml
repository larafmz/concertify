- event = request.event
- artist = event.artists.first
- event_date = event.date
- status = request.status

.request_item{id: "request-#{request.id}", style: "background: #{color_request(request.status)}; border-radius: 15px;"}

    .request

        - if request.accepted? ||  (request.status == 2 && request.existing_event_id.present?)
            = link_to event_path(request.get_event_id) do
                = image_tag artist&.photo if artist&.photo&.attached?
        - elsif artist&.accepted?
            = image_tag artist&.photo if artist&.photo.attached?
        - else
            %div


        %div{style: "padding: 15px 15px;"}
            - if artist
                - if artist.accepted?
                    = link_to artist_path(artist), id: "link_artist_#{artist.id}" do
                        %span{ style: "font-size: 20px; font-weight: 700;" }= artist&.complete_name || t("not_found")
                - else
                    %span{ style: "font-size: 20px; font-weight: 700;", id: "artist_name_#{artist.id}" }= artist&.complete_name || t("not_found")
                %br
            
            %span{ style: "font-size: 18px;", class: "soft-color", id: "tour_name_#{request.id}" } #{event.complete_name}
            %br

            .softest-color{style: "font-size: 15px;" }
                %span{style: "display:flex; align-items:center; gap:10px;"}
                    = image_tag("icon_ubication_softest_color.png", class: "icon-img")
                    = event.ubication&.complete_name_with_venue || t("not_found")
                    = image_tag("icon_date_softest_color.png", class: "icon-img")
                    = short_date(event.date)
            
            %span{style: "color: #{color_request(request.status)}; font-size: 16px;"}
                ● #{request.message_request}

        %div{ style: "display: flex; flex-direction: column; justify-content: space-between; height: 100%; padding: 15px 15px;"}
            %div{style: "background: #{request.second_color_request}; color: #{color_request(request.status)}; border-radius: 15px; font-size:15px; padding: 5px 10px; " }
                #{request.emoji_request} #{request.status_string}
            - if can?(:update, request)
                %div{style: "display: flex; gap: 20px;"}
                    = link_to "✎", edit_request_path(request), data: { turbo_frame: "modal" }, id: "edit_request_#{request.id}"
                    = link_to "✗", request_path(request), data: { turbo_method: :delete, turbo_confirm: "¿Esta seguro de que desea eliminar el evento solicitado?" }
            - if request.accepted? ||  (request.status == 2 && request.existing_event_id.present?)
                = link_to t("crud.show", model: Event.singular), event_path(request.get_event_id), class: "btn-custom event-color", style: "background-color: #069e34;font-size: 13px; width: 150px;"
    
    .sent_at
        = t("sent_ago_by", user: request.requester&.username , time: time_ago_in_words(request.created_at))
        - if status == Request::STATUS_ACCEPTED
            ="//"
            = t("accepted_ago", time: time_ago_in_words(request.updated_at))
        - elsif status == Request::STATUS_DENIED
            ="//"
            = t("denied_ago", time: time_ago_in_words(request.updated_at))
