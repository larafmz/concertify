.concerts-items
    - if concerts.empty? 
        = t("not_found_model", model: Concert.plural.downcase )
    - else
        - concerts.each_with_index do |item, index|
            - concert = item[:concert]
            - concert_date = item[:date]
            - concert_time = item[:time]

            - if index == 0
                .separator

            .item-concert
                .date-concert
                    = I18n.l(concert_date, format: "%B")[0,3].upcase
                    %br
                    %span{style: "font-size:20px;"}= concert_date.day
                    %br
                    - if concert_date.year != Date.today.year
                        = concert_date.year

                .concert-info
                    %span.soft-color
                        = formatted_concert_date(concert_date, concert_time)
                    %br
                    %span{style: "font-weight:600"}
                        - if item[:source] == :db
                            = link_to concert_path(concert) do
                                = concert.tour_name
                        - else
                            = link_to concert_path(id: "ticketmaster", ticketmaster_id: get_concert_id(concert)) do
                                = get_concert_name(concert)
                    %br
                    %span.soft-color
                        - if item[:source] == :db
                            = concert.ubication&.complete_name_with_address
                        - else
                            = get_full_ubication(concert)

                - if current_user
                    .button-concert
                        - concert_date_status = time_status(concert_date, concert_time)
                        - if concert_date_status == "past"
                            - if item[:source] == :db
                                - register = Register.find_by(user_id: current_user.id, concert_id: concert.id)
                            - else
                                - register = Register.joins(:concert).where(user_id: current_user.id, concerts: { ticketmaster_id: concert["id"] }).first
                            - if register
                                = link_to t("crud.edit", model: Register.singular), edit_register_path(id: register.id), class: "btn-custom", data: { turbo_frame: "modal" }
                            - elsif item[:source] == :db
                                = link_to t("registers.assisted"), new_register_path(concert_id: concert.id), class: "btn-custom-orange", data: { turbo_frame: "modal" }
                            - else
                                = link_to t("registers.assisted"), new_register_path(ticketmaster_id: concert["id"]), class: "btn-custom-orange", data: { turbo_frame: "modal" }
                        - elsif concert_date_status == "future"
                            - if item[:source] == :db
                                - future_assistance = FutureAssistance.find_by(user_id: current_user.id, concert_id: concert.id)
                            - else
                                - future_assistance = FutureAssistance.joins(:concert).where(user_id: current_user.id, concerts: { ticketmaster_id: concert["id"] }).first
                            - if future_assistance
                                = link_to t("crud.edit", model: FutureAssistance.singular), edit_future_assistance_path(id: future_assistance.id), class: "btn-custom", data: { turbo_frame: "modal" }
                            - elsif item[:source] == :db
                                = link_to t("registers.will_assist"), new_future_assistance_path(concert_id: concert.id), class: "btn-custom-orange", data: { turbo_frame: "modal" }
                            - else
                                = link_to t("registers.will_assist"), new_future_assistance_path(ticketmaster_id: concert["id"]), class: "btn-custom-orange", data: { turbo_frame: "modal" }
            
            - if index != concerts.count-1
                .separator