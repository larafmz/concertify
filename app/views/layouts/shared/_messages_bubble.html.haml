= turbo_stream_from current_user, "messages_header"
%div{id: "messages_header"}
    - unread_chats = current_user.chat_users.unread.size
    - if unread_chats > 0
        .message_notification{style: "width:18px; height:18px; border-radius:50%; background:var(--orange); color: var(--background); display:flex; justify-content:center; align-items:center; font-size:13px; font-weight:bold; margin-top:-6px;"}
            = unread_chats