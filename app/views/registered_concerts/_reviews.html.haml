.section-box
    .title 
        REGISTROS POPULARES
    .separator{style: "background: rgb(202, 202, 202);"}
    - if @registered_concerts.empty?
        = t("not_found_model", model: RegisteredConcert.plural.downcase )

    - @registered_concerts[0..9].each do |register|
        .review
            .small_icon 
                = register.user.id
            %div
                %div
                    %span{style: "font-weight: 700", class: "soft-color"} Review by 
                    -# = link_to user_path(current_user.id) do (TO/DO)
                    %span{style: "font-weight: 700"}=current_user.email
                    %span{style: "color: orange"}= register.get_puntuation
                %div
                    =register.text

                        