- if current_user
    .concert_add
        .two-columns{style: "grid-template-columns: auto 1fr;"}
            %div
                %h5 ¿No encuentras tu concierto?
                .soft-color
                    Si el concierto no aparece en los resultados, puedes solicitar su adición manualmente.
            %span{ style: "margin-left: auto" }
                = link_to "+ Añadir concierto", new_concert_path, class: "btn-custom", data: { turbo_frame: "modal" }
