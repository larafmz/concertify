%div{data: { controller: "pagination", pagination_url_value: url_for(@pagination_path), pagination_page_value: 2 } }
    .artists-list{id: "users", data: { pagination_target: "users" }}
        - users.each do |user|
            = render "users/index_item", user: user
            
        - unless users.respond_to?(:next_page) && users.next_page
            %span{class: "hidden", data: { pagination_target: "noRecords" }}