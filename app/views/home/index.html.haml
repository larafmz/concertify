.widget-content{style: "color: #a4b3c4;"}


  %div{style: "margin-top: 20px;"}
    %div{ style: "display: flex; justify-content: space-between; align-items: center; color: #a4b3c4;" }
      =link_to registered_concerts_path do
        =RegisteredConcert.plural.upcase 
        =t("recents").upcase
      =link_to registered_concerts_path do
        = t("more").upcase
    .separator{style: "margin-bottom: 15px; "}
    = render "registered_concerts/index_cards", registers: @registers.limit(6)

  %div{style: "margin-top: 20px;"}
    %div{ style: "display: flex; justify-content: space-between; align-items: center; color: #a4b3c4;" }
      =link_to artists_path do
        #{Artist.plural.upcase} #{t("populars").upcase}
      =link_to artists_path do
        = t("more").upcase
    .separator{style: "margin-bottom: 15px; "}
    .items
      = render "artists/index_db", artists: @artists_db.first(10)


  %div{style: "margin-top: 20px;"}
    =Concert.plural.upcase 
    =t("recents").upcase
    - if current_user && current_user.ubication&.country
      =t("from_followed_artists").upcase
    .separator{style: "margin-bottom: 15px; "}
    - if !@concerts.empty?
      .section-box
        = render "concerts/index_db", concerts: @concerts.limit(5)

  - if @concerts_close.present?
    %div{style: "margin-top: 20px;"}
      =Concert.plural.upcase 
      =t("recents").upcase
      =t("close_to_you").upcase
      .separator{style: "margin-bottom: 15px; "}
      - if !@concerts_close.empty?
        .section-box
          = render "concerts/index_db", concerts: @concerts_close.limit(5)
