= render "searchs/options", active: :artists

.separator

.widget-content{style: "color: #a4b3c4; padding-top:0px;"}
    .section-box
        = form_tag artists_path, method: "GET" do
            %div{style: "display: grid; grid-template-columns: 1fr 1fr auto auto; gap: 10px;"}
                %div
                    = label_tag :search, Artist.human_attribute_name(:name).upcase, class: "soft-color", style: "font-size: 13px;"
                    = text_field_tag :search, params[:search], placeholder: "🔍 #{t("search_artist")}", class: "field-custom"
                %div
                    = label_tag :genre_id, Genre.singular.upcase, class: "soft-color", style: "font-size: 13px;"
                    = select_tag :genre_id, options_for_select(Genre.all.map { |genre| [t(genre.name), genre.id] }, params[:genre_id]),include_blank: t("all_masc", model: Genre.plural), class: "field-custom", style: "background: #0F1419; padding: 0px;"
                %div
                    %br  
                    = submit_tag t("verbs.filter"), class: "btn-custom artist-color"
                %div
                    %br  
                    = link_to t("verbs.remove_filters"), artists_path, class: "btn-custom artist-color"
        
    - if @artists.empty?
        = render "common/empty_list_message", model: Artist
    -else 

        .artists-index{style: "color:#e9e9e9; "}
            - @artists.each do |item|
                - artist = item[:artist]

                %div
                    %div{ style: "height:10px;"}    
                    - if item[:source] == :db
                        = link_to artist_path(artist), class: "hover-border-icon" do
                            .link_icon{style: "width: 120px; height: 120px;"}
                                = image_tag  artist.photo if artist.photo.attached?
                    - else
                        = link_to artist_path(id: "ticketmaster", ticketmaster_id: artist.dig("id")), class: "hover-border-icon" do
                            .link_icon{style: "width: 120px; height: 120px;"}
                                = image_tag  best_quality_image(artist.dig("images")).dig("url")

                    .artist-name{ style: " font-size: 13px; width: 120px; display: flex;  justify-content: center; text-align: center;"}    
                        - if item[:source] == :db
                            = link_to artist_path(artist) do
                                = artist.name
                        - else
                            = link_to artist_path(id: "ticketmaster", ticketmaster_id: artist.dig("id")) do
                                = artist.dig("name")      

        = paginate @artists                    

