.widget-content.list
    %h2{ style: "color: white;" } Futuros Conciertos de #{current_user.email} #TO/DO username
    .registers-items
        - @future_assistances.each do |future_assistance|
            - concert = future_assistance.concert
            - concert_date = concert.date
            .item-register
                .date-concert{ style: "color: black;"}
                    = concert_date.strftime("%B")[0,3].upcase
                    %br
                    %span{ style: "font-size: 20px;" }= concert_date.day
                    %br
                    - if concert_date.year != Date.today.year
                        = concert_date.year
                = link_to future_assistance_path(future_assistance.id) do 
                    .rectangle_icon{ style: "height: 90px; width: 150px; border: 1px solid " }
                        = image_tag concert.photo if concert.photo.attached?
                %div
                    = link_to future_assistances_path(future_assistance.id) do 
                        %span{ style: "font-size: 20px;" }= concert.tour_name
                    %br
                    %span{style: "color: rgb(189, 189, 189);"}= concert.ubication.complete_name
                - if future_assistance.user_id = current_user.id
                    .button-concert
                        - concert_date_status = time_status(concert_date, concert.start_time)
                        - if concert_date_status == "future"
                            = link_to "✎", edit_future_assistance_path(id: future_assistance.id), data: { turbo_frame: "modal" }
                        - else
                            = link_to "Registrar concierto", new_registered_concert_path(concert_id: concert.id), class: "btn-custom", data: { turbo_frame: "modal" }
                        = link_to "delete", future_assistance_path(future_assistance), data: { turbo_method: :delete, turbo_confirm: "¿Esta seguro de que desea eliminar la futura asistencia?" }, class: "dropdown-item"
                %div

