= turbo_stream.remove "spinner"

= turbo_stream.append "index-registers" do
  - @registers.each do |register|
    = render "registers/index_item", register: register

- unless @registers.respond_to?(:next_page) && @registers.next_page
  = turbo_stream.append "index-registers" do
    %span.hidden{data: { pagination_target: "noRecords" }}