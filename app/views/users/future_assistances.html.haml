= render "users/options", active: :future_assistances

.widget-content{style: "padding-top:0px;", data: { controller: "pagination", pagination_url_value: future_assistances_user_path(@user), pagination_page_value: 2 } }
    %div{id: "future_assistances", data: { pagination_target: "future_assistances" } }
        - if @future_assistances.empty?
            = render "common/empty_list_message", model: FutureAssistance
        - else
            - @future_assistances.each do |future_assistance|
                = render "future_assistances/index_item", future_assistance: future_assistance

    - unless @future_assistances.respond_to?(:next_page) && @future_assistances.next_page
        %span{class: "hidden", data: { pagination_target: "noRecords" }}