- event_date = event.date
- event_time = event.start_time
.item-event{style: "margin-top: 10px;"}
    .date-event
        = I18n.l(event_date, format: "%B")[0,3].upcase
        %br
        %span{style: "font-size:20px;"}= event_date.day
        %br
        - if event_date.year != Date.today.year
            = event_date.year

    .event-info{style: "text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px  1px 0 #000, 1px  1px 0 #000;"}
        %span
            = wday_time(event_date, event_time)
        %br
        %span{style: "font-weight:600"}
            = link_to event_path(event) do
                = event.tour_name
        %br
        %span
            = event.ubication&.complete_name_with_venue