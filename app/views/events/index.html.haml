= render "searchs/options", active: :events

%div{ style: "background: var(--background);color: var(--main-text-color); font-family: Georgia, 'Times New Roman', Times, serif; font-size: 25px; padding: 5px 50px 0px 50px;" }
    = render "events/index_header"

.separator

.widget-content{style: "color: var(--soft-color); padding-top:0px;"}

    .section-box
        = render "events/filters", search_by_name: true
        .separator{style: "margin-bottom: 15px; "}
        = render "events/index", events: @events, photo: true

    - if can?(:create, Request)
        = render "events/manual_add"
