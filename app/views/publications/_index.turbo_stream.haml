= turbo_stream.append "publications-list" do
    - @publications.each do |publication|
        = render "publications/show", publication: publication
        .separator

= turbo_stream.replace "pagination" do
    %div{id: "pagination"}
        - if @publications.respond_to?(:next_page) && @publications.next_page && @pagination_path
            = link_to "Cargar más",
                url_for(@pagination_path.merge(page: @publications.next_page)),
                data: { turbo_stream: true },
                class: "btn-standard",
                style: "margin: 10px;"