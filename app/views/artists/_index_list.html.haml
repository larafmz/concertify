.widget-content{style: "padding-top:0px;"}  
    - if artists.empty?
        = render "common/empty_list_message", model: Artist
        
    - else
        %div      
            .artists-list
                - artists.each_with_index do |artist, index|
                    - if artist.is_favorite(current_user)
                        %div{ style: "height:10px; font-size: 13px; width: 120px; display: flex;  justify-content: center;"}    
                            ❤ 
                    - else
                        %div{ style: "height:10px;"}    
                    .register_user{style: "grid-template-columns: 0.1fr 4fr auto; border-radius: 0px;"}
                        = link_to artist_path(artist), class: "hover-border-icon" do 
                            .link_icon
                                = image_tag artist.photo if artist.photo.attached?

                        %div
                            = link_to artist_path(artist) do
                                %span{ style: "font-size: 15px; font-weight: 700;" }= artist.name
                            .softest-color{style: "font-size: 12px;" }
                                = link_to followers_artist_path(artist), class: "hover-border-icon" do 
                                    = artist.relations.count
                                    = t("followers").downcase

                        .softest-color
                            = render "artists/follow_buttoms", artist: artist
                            
                    
                = paginate @artists                    
                        