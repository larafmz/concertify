.widget-content

    %h4{style: "color: white;"} Configuración de la Cuenta
    = form_with model: @user do |f|

        - if @user.errors.any?
            .form-errors
                - @user.errors.full_messages.each do |message|
                    ● #{message}
                    %br
    
        .two-columns{style: "gap: 20px;"}
            .section-box
                %h6{class: "soft-color"} Perfil

                = label_tag :username, "Nombre de usuario", class: "soft-color", style: "font-size: 13px;"
                = f.text_field :username, class: "field-custom"
                %br
                %br 

                = label_tag :name, "Nombre", class: "soft-color", style: "font-size: 13px;"
                = f.text_field :name, class: "field-custom"
                %br   
                %br 

                = label_tag :email, "Email", class: "soft-color", style: "font-size: 13px;"
                = f.text_field :email, class: "field-custom"
                %br   
                %br  

                .two-columns{style: "gap: 20px;"}
                    %div
                        = label_tag :country, "📍 País", class: "soft-color", style: "font-size: 13px;"
                        = select_tag :country, options_for_select(Country.all.map { |country| [country.name, country.code] }, @user.ubication&.country&.code), include_blank: "Seleccionar", class: "field-custom", style: "padding: 0px;"
                    %div
                        = label_tag :city, "📍 Ciudad", class: "soft-color", style: "font-size: 13px;"
                        = text_field_tag :city, @user.ubication&.city, class: "field-custom"
                %br   
                
                = label_tag :description, "Descripción", class: "soft-color", style: "font-size: 13px;"
                = f.text_area :description, placeholder: "Añadir descripcion", style: "width: 100%; height: 100px; resize: vertical;", class: "field-custom"
              
            
            .section-box
                %h6{class: "soft-color"} Cantantes favoritos
            
        = f.submit "Guardar", style: "float: right", class: "btn-custom"