%div{ class: "widget-content", style: "background: #1f252b;"}
    %div{ class: "artist-content", style: "background: #1f252b;"}
        .artist-info
            .circle_icon
                = image_tag  @concert.photo, class: "artist-avatar" if @concert.photo.attached?
                
            .artist-name
                %div= @concert.tour_name
                .soft-color{ style: "font-size: 15px;" }
                    %span= "📍#{@concert.ubication&.complete_name} 🗓️ #{short_date_with_year(@concert.date)}" 
        .flex
            .stat
                - if @concert_date_status == "past"
                    .number 
                        = @concert.registered_concerts.size
                    .name
                        = link_to registered_concerts_path(concert_id: @concert.id) do   
                            = t("totals", model: RegisteredConcert.plural)
            
            .stat
                - if @concert_date_status == "past"
                    .number
                        ★ #{@concert.average_rating} / 5
                    .name
                        = t("average", model: RegisteredConcert.plural)
                - else
                    .number
                        = @concert.future_assistances.size
                    .name
                        = t("totals", model: FutureAssistance.plural)

            .stat
                .number
                    (TO/DO)
                .name
                    =Publication.plural

    
    %div{style: "display:flex; align-items:center; gap:8px; padding-top: 40px;"}

        
        .section-box
            %h5{ style: "color: white" }= Artist.plural
            .artists-grid
                - @concert.artists.each do |artist|
                    = link_to artist_path(artist.id), style: "display:flex; align-items:center; gap:8px;" do 
                        .icon
                            = image_tag  artist.photo, class: "artist-avatar" if artist.photo.attached?
                        = artist.name

        - if current_user
            %span{ style: "margin-left: auto; background: #1f252b;" }
                - if @concert_date_status == "past"
                    - register = RegisteredConcert.find_by(user_id: current_user.id, concert_id: @concert.id)
                    - if !register
                        = link_to t("registers.assisted"), new_registered_concert_path(concert_id: @concert.id), class: "btn-custom", data: { turbo_frame: "modal" }, style: "height: auto;"
                    - else
                        = link_to t("my_model", model: RegisteredConcert.singular), interactuable_path(id: register.id), class: "btn-custom-orange", style: "height: auto;"
                - if @concert_date_status == "future"
                    - future_assistance = FutureAssistance.find_by(user_id: current_user.id, concert_id: @concert.id)
                    - if !future_assistance
                        = link_to t("registers.will_assist"), new_future_assistance_path(concert_id: @concert.id), class: "btn-custom", data: { turbo_frame: "modal" }, style: "height: auto;"
                    - else
                        = link_to t("my_model", model: FutureAssistance.singular), future_assistances_path(user_id: current_user.id), class: "btn-custom-orange", style: "height: auto;"
   

.separator{style: "background: #40556d; "}

.widget-content{style: "color: #a4b3c4;"}

    - if @concert_date_status == "past"
        %div{ style: "display: flex; justify-content: space-between; align-items: center;" }
            = link_to registered_concerts_path(concert_id: @concert.id) do   
                =t("populars", model: RegisteredConcert.han("reviews")).upcase
            = link_to registered_concerts_path(concert_id: @concert.id) do   
                %span= t("more").upcase
        .separator{style: "margin-bottom: 15px; "}
        - if @reviews.empty?
            = t("not_found_model", model: RegisteredConcert.han("reviews").downcase )
        = render "registered_concerts/reviews", registered_concerts: @reviews
    - else
        %div{ style: "display: flex; justify-content: space-between; align-items: center;" }
            = link_to future_assistances_path(concert_id: @concert.id) do   
                =FutureAssistance.plural.upcase 
            = link_to future_assistances_path(concert_id: @concert.id) do   
                %span= t("more").upcase
        .separator{style: "margin-bottom: 15px; "}
        - if @future_assistances.empty?
            = t("not_found_model", model: FutureAssistance.plural.downcase )
        = render "future_assistances/index", future_assistances: @future_assistances
   
    %div{ style: "margin-top: 20px;" }
        %div{ style: "display: flex; justify-content: space-between; align-items: center;" }
            = link_to publications_path(concert_id: @concert.id) do   
                =t("populars", model: Publication.plural).upcase
            = link_to publications_path(concert_id: @concert.id) do   
                %span= t("more").upcase
        .separator{style: "margin-bottom: 15px; "}
        - if @reviews.empty?
            = t("not_found_model", model: Publication.plural.downcase )
        = render "publications/index", publications: @publications
        TO/DO