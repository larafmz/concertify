= render "users/header"
= render "users/options", active: :profile

.widget-content{style: "color: var(--soft-color); padding-top:0px;"}
        
    .big-second-column{style: "color: var(--soft-color); "}
        %div{style: "margin-right: 20px; "}

            = User.human_attribute_name(:description).upcase
            .separator{style: "margin-bottom: 15px; "}
            = simple_format(@user.description)

            %div{style: "margin-bottom: 20px; margin-top: 20px;"}
                =FavoriteArtist.plural.upcase
                .separator
                - if  @favorite_artists.empty?
                    %div{style: "padding-top:15px;"}
                        = render "common/empty_list_message", model: Artist
                .favorite_artists
                    - @favorite_artists.first(4).each do |artist|
                        = link_to artist_path(artist), class: "hover-border" do
                            .favorite_artist_icon
                                = image_tag artist.photo if artist.photo.present?


            %div{ style: "display: flex; justify-content: space-between; align-items: center ;margin-top: 15px; " }
                = link_to future_assistances_user_path(@user) do
                    = FutureAssistance.plural.upcase
                = link_to future_assistances_user_path(@user) do
                    %span= @user.future_assistances.size   
            .separator{style: "margin-bottom: 15px; "}
            .flex{style: "margin-top: 10px;"}
                = link_to future_assistances_user_path(@user), class: "hover-border", style: "display: flex; align-items: flex-start; justify-content: space-between;" do
                    - @future_assistances.limit(6).each do |future_assistance|
                        .small_vertical_rectangle
                            = image_tag future_assistance.event.get_photo if future_assistance.event.get_photo.present?


        %div{style: "margin-bottom: 20px; "}
  
            %div{style: "margin-bottom: 20px;"}
                %div{style: "display: flex; justify-content: space-between; align-items: center; width: 100%;"}
                    = link_to registers_user_path(@user) do
                        = t("recents", model: Register.plural).upcase
                    = link_to registers_user_path(@user) do
                        %span= t("more").upcase
                .separator
                = render "registers/index_cards", registers: @registers

            %div{style: "margin-bottom: 20px; "}
                %div{ style: "display: flex; justify-content: space-between; align-items: center;" }
                    = link_to registers_user_path(@user, filter: "populars") do
                        = t("populars", model: Register.plural).upcase
                    = link_to registers_user_path(@user, filter: "populars") do
                        %span= t("more").upcase
                .separator{style: "margin-bottom: 15px;"}
                = render "registers/index", registers: @populars_registers

            %div{style: "margin-top: 20px;"}
                .title_section
                    =link_to publications_user_path(@user) do
                        =t("recents", model: Publication.plural).upcase
                    =link_to publications_user_path(@user) do
                        = t("more").upcase
                .separator{style: "margin-bottom: 15px; "}
                = render "publications/index", publications: @publications

            %div{style: "margin-top: 20px;"}
                .title_section
                    =link_to publications_user_path(@user, filter: "populars") do
                        =t("populars", model: Publication.plural).upcase
                    =link_to publications_user_path(@user, filter: "populars") do
                        = t("more").upcase
                .separator{style: "margin-bottom: 15px; "}
                = render "publications/index", publications: @populars_publications        

        
