.widget-content{style: "padding-top:0px;"}  

    - if registers.empty?
        .message
            ℹ️
            = t("not_found_model", model: Register.plural.downcase )

    .registers-items{style: "background: #1e2731; border-radius: 15px; gap: 0px;"}

        - registers.each do |register|
            - concert = register.concert
            - concert_date = concert.date

            .diary-wrapper
                = link_to interactuable_path(register.id), class: "diary-link" do 
                    .diary-obj
                        .date-concert
                            = concert_date.strftime("%B")[0,3].upcase
                            %br
                            %span{ style: "font-size: 20px;" }= concert_date.day
                            %br
                            - if concert_date.year != Date.today.year
                                = concert_date.year

                        .diary_icon
                            = image_tag concert.photo if concert.photo.attached?

                        %div
                            - concert.artists.each_with_index  do |artist, index|
                                %span{ style: "font-size: 20px; font-weight: 700;" }= artist&.name || "not found"
                                - if index < concert.artists.size - 1
                                    ,
                            %br

                            %span{ style: "font-size: 18px;", class: "soft-color; " } #{concert.tour_name}
                            
                            - ub = concert.ubication&.complete_name || "ubication unidentified"
                            .softest-color{style: "font-size: 15px; padding-bottom: 10px;" }
                                %span= "📍#{ub}" 
                        %div{style: "color: orange"}= register.get_rating
   
