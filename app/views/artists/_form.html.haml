= turbo_frame_tag "modal" do
  = tag.dialog class: "custom_modal", data: { controller: "dialog" }, style: "background: #1e2731;" do

    .modal_header
      %h5=t("crud.add", model: Artist.singular)
      %button.modal_close{ data: { action: "dialog#close" } } ×

    .modal_body
      = form_with model: @artist, data: { turbo: false } do |f|
        
        = f.hidden_field :requester_id, value: current_user&.id
        = f.hidden_field :status, value: 1
        
        .form-modal

          .form-modal-info
         
            = label_tag :name, Artist.human_attribute_name(:name), class: "soft-color", style: "font-size: 13px;"
            = f.text_field :name, placeholder: "Ej: Taylor Swift", class: "field-custom"

        %br
        = f.submit t("verbs.save"), style: "float: right", class: "btn-custom", style: "height: auto"