.auth-page-background
  .auth-form-card
    %h4.auth-form-title= t("user_account.login")

    = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
      .auth-form-fields

        .auth-form-field
          = f.label :email, User.human_attribute_name(:email), class: "auth-form-label"
          = f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-form-input", id: "email_id"

        .auth-form-field
          = f.label :password, User.human_attribute_name(:password), class: "auth-form-label"
          = f.password_field :password, autocomplete: "current-password", class: "auth-form-input", id: "password_id"

        - if devise_mapping.rememberable?
          .auth-form-remember
            = f.check_box :remember_me
            = f.label :remember_me, User.human_attribute_name(:remember_me)

      = f.submit t("user_account.login"), class: "auth-form-submit"