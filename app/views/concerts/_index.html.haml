.concerts-items
    - if !concerts.nil?
        - concerts[0..20].each do |concert|
            .item-concert
                - concert_date = get_concert_date(concert)
                .date-concert
                    = concert_date.strftime("%B")[0,3].upcase
                    %br
                    %span{ style: "font-size: 20px;" }= concert_date.day
                    %br
                    - if concert_date.year != Date.today.year
                        = concert_date.year
                .concert-info
                    %span{ style: "color: #696969;" }
                        = formatted_concert_date(concert_date, get_concert_time(concert))
                    %br
                    %span{ style: "font-weight: 600" }
                        = get_concert_name(concert)
                    %br
                    %span{ style: "color: #696969;" }
                        - venue = get_concert_venue(concert)
                        - if !venue.nil?
                            #{get_venue_city(venue)}, #{get_venue_state(venue)},  #{get_venue_country(venue)} • #{get_venue_address(venue)}
                - if current_user
                    .button-concert
                        - if concert_date < Date.today
                            = link_to "He asistido", new_registered_concert_path(concert_id: concert["id"]), class: "btn-custom", data: { turbo_frame: "modal" }

                        - if concert_date >= Date.today
                            = link_to "Asistiré", new_future_assistance_path, class: "btn-custom"
            .separator-horizontal  
          