.widget-content.list
    .title
    { style: "color: white;" } Conciertos solicitados
    .section-box
        .registers-items
            - @concerts.each do |concert|
                - artist = concert.artists.first
                - concert_date = concert.date
                .item-register
                    .date-concert{ style: "color: black;"}
                        = concert_date.strftime("%B")[0,3].upcase
                        %br
                        %span{ style: "font-size: 20px;" }= concert_date.day
                        %br
                        - if concert_date.year != Date.today.year
                            = concert_date.year
                    .rectangle_icon{ style: "height: 90px; width: 150px;" }
                        - if artist
                            = link_to artist_path(artist.id) do
                                = image_tag artist.photo if artist.photo.attached?
                    %div
                        %span{ style: "font-size: 20px;" } #{artist&.name} - #{concert.tour_name}
                        %br
                        %span{ class: "soft-color" }= concert.ubication&.complete_name
                    - if concert.requesting_user_id = current_user.id && concert.status != Concert::STATUS_ACCEPTED
                        .button-concert
                            = link_to "✗", concert_path(concert), data: { turbo_method: :delete, turbo_confirm: "¿Esta seguro de que desea eliminar el concierto solicitado?" }
                    - elsif concert.status == Concert::STATUS_ACCEPTED
                        .button-concert
                            = link_to "Ir a concierto", concert_path(concert)

                    

