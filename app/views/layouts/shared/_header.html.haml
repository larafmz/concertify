.header
  .logo
    = link_to root_path, title: t("root_title") do
      = image_tag("icon_logo.png", alt: t("root_title"))
  .app_name
    = link_to root_path, title: t("root_title") do
      Concertify

  = form_tag "/searchs", method: "GET" do
    = text_field_tag :search, params[:text], placeholder: t("search")

  .dropdown
    %button.btn.btn-secondary.dropdown-toggle{"data-bs-toggle" => "dropdown"}
      Opciones
    %ul.dropdown-menu
      %li= link_to "Editar"
      %li= link_to "Eliminar"