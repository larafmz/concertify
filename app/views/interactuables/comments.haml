- if @interactuable.publication?
    = render "users/options", active: :publications
- elsif @interactuable.register?
    = render "users/options", active: :reviews

.widget-content{style: "padding-top:0px; border: "}  

    %div{style: "border: 1px solid #40556d;"}

        %div{style: "margin:20px; margin-bottom:0px;"}
            - if @interactuable.register? 
                %div
                    = render "registers/show", register: @interactuable
            - elsif @interactuable.publication?
                %div
                    = render "publications/show", publication: @interactuable

        %div{style: "display: flex; gap: 20px; color: white; margin-left:20px; margin-top: 15px;"}
            = link_to Like.plural, interactuable_path(@interactuable), title: "#{@interactuable.likes.count} #{Like.plural}" 
            = link_to Comment.plural, comments_interactuable_path(@interactuable), style: ("color: white; border-bottom: 2px solid #eb5d25;"), title: "#{@interactuable.comments.count} #{Comment.plural}"
            = link_to Repost.plural, reposts_interactuable_path(@interactuable), title: "#{@interactuable.reposts.count} #{Repost.plural}"
        .separator

        - if current_user
            %div{style: "border-bottom: 1px solid #40556d;"}
                = form_tag comment_interactuable_path(@interactuable), method: :post, data: { turbo: false } do
                    %div{data: { controller: "character-counter" }, style: "margin:15px; display: grid; grid-template-columns: auto 1fr auto; color: white; gap: 10px; "}
                        %div
                            = link_to user_path(current_user), class: "hover-border-icon",style: "display: block;" do 
                                .link_icon
                                    = image_tag current_user.icon if current_user.icon.attached?
                        = text_area_tag :text, nil, maxlength: 500, placeholder: t("messages.write_your_answer"), style: "outline:none; color: white; border: none; background:none; width: 100%; height: 50px; resize: none;", data: {  character_counter_target: "input", action: "input->character-counter#update" }
                        %div{data: { character_counter_target: "counter" }, style: "text-align: right; font-size: 12px; color: #a4b3c4;"}
                    %div{style: "display: flex; justify-content: flex-end; margin: 10px;"}
                        = submit_tag t("verbs.answer"), class: "btn-custom-orange"

        - @comments.each do |comment|
            = render "comments/show", comment: comment