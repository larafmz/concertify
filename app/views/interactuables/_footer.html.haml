- heart = interactuable.likes.count == 0 ? "♡" : "❤"
.soft-color{style: "font-size: 15px; gap:30px; display: flex;"}
    %div{style: "display: flex;"}
        - if !current_user || (current_user.id == interactuable.user.id)
            = link_to likes_interactuable_path(interactuable.id) do 
                = heart
        - else
            = button_to like_interactuable_path(interactuable), method: :post, form: { data: { turbo: false } }, class: "button-without-format" do
                = heart
        - if interactuable.likes.count != 0
            = link_to likes_interactuable_path(interactuable.id) do 
                = interactuable.likes.count

    %div
        = link_to comments_interactuable_path(interactuable.id) do 
            💬
        - if interactuable.comments.count != 0
            = link_to comments_interactuable_path(interactuable.id) do 
                = interactuable.comments.count