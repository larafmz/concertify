
%div{ class: "widget-content", style: "background: #1f252b;"}
    %div{ class: "artist-content", style: "background: #1f252b;"}
        .artist-info
            .user_icon
                = image_tag  @artist.photo, class: "artist-avatar" if @artist.photo.attached?
                
            .artist-name
                = @artist.name
                - if @artist.genre
                    .softest-color{ style: "font-size: 15px" }
                        = @artist.genre.name

        .flex
            .stat
                .number
                    =  @registered_concerts.count
                .name
                    = link_to registered_concerts_path(artist_id: @artist.id) do   
                        = t("totals", model: RegisteredConcert.plural)
            
            .stat
                .number
                    ★ #{@artist.average_rating} / 5
                .name
                    = t("average", model: RegisteredConcert.plural)
            .stat
                .number
                    (TO/DO)
                .name
                    =Publication.plural
                    
    %div{style: "display:flex; align-items:center; gap:8px; padding-top: 10px;"}

        - if current_user
            %span{ style: "margin-left: auto; background: #1f252b;" }
                - if current_user.follows_artist?(@artist.id)
                    = link_to t("verbs.unfollow"), unfollow_artist_path(@artist.id), class: "btn-custom-orange", data: { turbo_method: :delete }
                - else
                    = link_to t("verbs.follow"), follow_artist_path(@artist.id), class: "btn-custom", data: { turbo_method: :post }
                - if current_user.favorite_artist?(@artist.id)
                    = link_to "♡ #{t("verbs.unmark_as_favorite")}", unmark_as_favorite_artist_path(@artist.id), class: "btn-custom-orange", data: { turbo_method: :delete }
                - elsif current_user.can_mark_favorite?
                    = link_to "♡ #{t("verbs.mark_as_favorite")}", mark_as_favorite_artist_path(@artist.id), class: "btn-custom", data: {  turbo_method: :post}
                - else
                    = link_to "♡ #{t("verbs.mark_as_favorite")}", mark_as_favorite_artist_path(@artist.id), class: "btn-custom", 
                        data: {  turbo_method: :post, controller: "alert", action: "click->alert#show", alert_message_value: t("messages.cant_mark_as_favorite") }
                 

.separator

.widget-content{style: "color: #a4b3c4;"}

    %div{ style: "display: flex; justify-content: space-between; align-items: center;" }
        = link_to registered_concerts_path(artist_id: @artist.id) do   
            =RegisteredConcert.han("reviews").upcase 
            =t("populars").upcase
        = link_to registered_concerts_path(artist_id: @artist.id) do   
            %span= t("more").upcase
    .separator{style: "margin-bottom: 15px; "}
    - if @reviews.empty?
        = t("not_found_model", model: RegisteredConcert.han("reviews").downcase )
    = render "registered_concerts/reviews", registered_concerts: @reviews

    %div{ style: "margin-top: 20px;" }
        %div{ style: "display: flex; justify-content: space-between; align-items: center;" }
            = link_to publications_path(artist_id: @artist.id) do   
                =Publication.plural.upcase 
                =t("populars").upcase
            = link_to publications_path(artist_id: @artist.id) do   
                %span= t("more").upcase
        .separator{style: "margin-bottom: 15px; "}
        - if @reviews.empty?
            = t("not_found_model", model: Publication.plural.downcase )
        = render "publications/index", publications: @publications
        TO/DO

    .section-box{style: "margin-top: 50px;"}
        .title
            #{Concert.plural.upcase} • #{@concerts.size} #{t("results").upcase}
        = render "concerts/filters", search_by_name: false
        = render "concerts/index", concerts: @concerts[0,10]

    .section-box
        = render "concerts/manual_add"
        
           