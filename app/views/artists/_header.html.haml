.widget-content{style: "background: #1f252b;"}
    .artist-content
        .artist-info
            .user_icon
                = image_tag  @artist.photo, class: "artist-avatar" if @artist.photo.attached?
                
            .artist-name
                = @artist.name
                - if @artist.genre && @artist.genre.name != "Undefined"
                    .softest-color{ style: "font-size: 15px" }
                        = @artist.genre.name

        .flex
            .stat
                .number
                    =  @artist.followers.viewables(current_user).count
                .name
                    = link_to followers_artist_path(@artist) do   
                        = t("followers")
            
            .stat
                .number
                    ★ #{@artist.average_rating} / 5
                .name
                    = t("average", model: Register.plural)
                    
    %div{style: "display:flex; align-items:center; gap:8px; padding-top: 10px;"}

        - if current_user
            %span{ style: "display: flex; margin-left: auto; background: #1f252b; gap:10px;" }
                - if current_user.follows_artist?(@artist)
                    = button_to unfollow_artist_path(@artist), class: "btn-standard", method: :delete, form: { data: { turbo: false } } do
                        = t("following")
                - else
                    = button_to follow_artist_path(@artist), method: :post, form: { data: { turbo: false } }, class: "btn-standard-orange" do                  
                        = t("verbs.follow")
                - if current_user.favorite_artist?(@artist)
                    = link_to "♡ #{t("favorite")}", unmark_as_favorite_artist_path(@artist), class: "btn-standard", data: { turbo_method: :delete }
                - elsif current_user.can_mark_favorite?
                    = button_to mark_as_favorite_artist_path(@artist), class: "btn-standard-orange", method: :post, form: { data: { turbo: false } } do
                        ♡ #{t("verbs.mark_as_favorite")}
                - else
                    = button_to mark_as_favorite_artist_path(@artist), class: "btn-standard-orange", method: :post, form: { data: { turbo: false, controller: "alert", action: "click->alert#show", alert_message_value: t("messages.cant_mark_as_favorite") } } do
                        ♡ #{t("verbs.mark_as_favorite")}
            - if current_user.admin? && @artist.manually_added
                = link_to t("crud.edit", model: Artist.singular), edit_artist_path(@artist), data: { turbo_frame: "modal" }, class: "btn-standard-orange"
                       
