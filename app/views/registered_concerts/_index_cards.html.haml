.columns{style: "margin-top: 10px; grid-template-columns: repeat(#{registers.count}, 1fr);"}
  - registers.each do |register|
    .concert-card{style: "display: flex; flex-direction: column;"}
      = link_to registered_concert_path(register.id), class: "hover-border" do
        .item-name{style: "width: 190px; height: 30px;", class: "soft-color"}
          %div{style: "display: flex; align-items: center; justify-content: flex-start; gap: 8px;"}
            .smaller_icon{style: "width: 25px; height: 25px; margin-left: 5px;"}
              = image_tag register.user.icon, style: "width: 100%; height: 100%; object-fit: cover;" if register.user.icon.attached?
            %span= register.user.username
        .rectangle_icon{style: "width: 190px; height: 150px;"}
          = image_tag register.concert.photo, class: "artist-avatar" if register.concert.photo.present?
        .item-name{style: "width: 190px;"}
          = register.concert.tour_name
      %div{ style: "display: flex; justify-content: space-between; align-items: center; color: #a4b3c4;" }
        %div
          =register.get_rating
          - if register.review.present?
            %span{style: "font-size:12px;"} 💬 
        %span{style: "font-size:12px;"}= short_date(register.created_at)