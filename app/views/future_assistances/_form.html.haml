= turbo_frame_tag "modal" do
  = tag.dialog class: "custom_modal", data: { controller: "dialog" } do

    .modal_header
      Asistiré a...
      %button.modal_close{ data: { action: "dialog#close" } } ×

    .modal_body
      = form_with model: @future_assistance, data: { turbo: false } do |f|
        
        = hidden_field_tag :ticketmaster_id, params[:ticketmaster_id]
        = f.hidden_field :concert_id, value: params[:concert_id] if @future_assistance.concert_id.nil?
        = f.hidden_field :user_id, value: current_user&.id
        
        .form-modal

          .rectangle_icon
            - if @concert_api
              = image_tag get_concert_image_url(@concert_api)
            - else
              = image_tag  @concert.photo if @concert.photo.attached?

          .form-modal-info
            %span{ style: "font-size: 20px;" }
              - if @concert_api
                = get_concert_name(@concert_api)
              - else
                = @concert.tour_name

            %span{ style: "font-size: 13px;" }
              - if @concert_api
                = "#{get_full_ubication(@concert_api)} - #{get_concert_date(@concert_api).strftime("%d %B %Y")}"
              - else
                = "#{@concert.ubication.complete_name} - #{@concert.date.strftime("%d %B %Y")}"

            .separator{style: "background: #40556d; "}

            %div
              = label_tag :from, "Salgo de:", class: "soft-color", style: "font-size: 13px;"
              = f.text_field :from, placeholder: "Salgo de...", class: "field-custom"
         
            = label_tag :concert_seat, "Ubicación en el concierto:", class: "soft-color", style: "font-size: 13px;"          
            %span{ style: "display: grid; grid-template-columns: 1fr 3fr; gap: 10px" }
              = f.select :concert_seat, FutureAssistance.concert_seats_for_select, prompt: "Seleccionar...", class: "field-custom"
              = f.text_field :concert_seat_details, placeholder: "Detalles de la Ubicación"

            %div
              = f.check_box :alone
              = f.label :alone, "Voy solo"     

        %br
        = f.submit "Guardar", style: "float: right"