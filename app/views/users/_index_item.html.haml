.register_user{style: "grid-template-columns: 0.1fr 4fr auto; border-radius: 0px;"}
    = link_to user_path(user), class: "hover-border-icon" do 
        .link_icon
            = image_tag user.icon if user.icon.attached?

    %div
        = link_to user_path(user) do
            %span{ style: "font-size: 15px; font-weight: 700;" }= user.username
        .softest-color{style: "font-size: 12px;" }
            = link_to followers_user_path(user), class: "hover-border-icon" do 
                = user.followers.count
                = t("followers").downcase
            ,
            = link_to followers_user_path(user), class: "hover-border-icon" do 
                = user.followings.users.count
                = t("following").downcase

    = render "users/relation_bottoms", user: user

