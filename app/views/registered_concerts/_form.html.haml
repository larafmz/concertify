= turbo_frame_tag "modal" do
  = tag.dialog class: "custom_modal", data: { controller: "dialog" } do

    .modal_header
      %h5 Asistí a...
      %button.modal_close{ data: { action: "dialog#close" } } ×

    .modal_body
      = form_with model: @registered_concert, data: { turbo: false } do |f|
        
        = hidden_field_tag :ticketmaster_id, params[:ticketmaster_id]
        = f.hidden_field :concert_id, value: params[:concert_id] if @registered_concert.concert_id.nil?
        = f.hidden_field :user_id, value: current_user&.id
        
        .form-modal

          .rectangle_icon
            - if @concert_api
              = image_tag get_concert_image_url(@concert_api)
            - else
              = image_tag  @concert.photo if @concert.photo.attached?

          .form-modal-info

            %span{ style: "font-size: 20px;" }
              - if @concert_api
                = get_concert_name(@concert_api)
              - else
                = @concert.tour_name

            %span{ style: "font-size: 13px;" }
              - if @concert_api
                = "#{get_full_ubication(@concert_api)} - #{get_concert_date(@concert_api).strftime("%d %B %Y")}"
              - else
                = "#{@concert.ubication.complete_name} - #{short_date(@concert.date)}"

            .separator{style: "background: #40556d; "}

            = label_tag :text, "Reseña:", class: "soft-color", style: "font-size: 13px;"
            = f.text_area :text, placeholder: "Añadir reseña", style: "width: 100%; height: 100px; resize: vertical;", class: "field-custom"
            
            .puntuation
              %div= label_tag :puntuation, "Rating:", class: "soft-color", style: "font-size: 13px;"
              - (1..5).each do |i|
                = f.radio_button :puntuation, i
                = f.label :"puntuation_#{i}" do
                  - (1..i).each do 
                    ★
        %br
        = f.submit "Guardar", style: "float: right"