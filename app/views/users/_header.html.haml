%div{ class: "widget-content", style: "background: #1f252b;"}
    %div{ class: "artist-content", style: "background: #1f252b;"}
        .artist-info
            .user_icon
                = image_tag  @user.icon, class: "artist-avatar" if @user.icon.attached?
                
            .artist-name
                %div= @user.username
                - if current_user.id == @user.id
                    = link_to t("crud.edit", model: t("profile")), edit_user_path(current_user.id), class: "small-btn-custom"
                - if @user.ubication
                    .soft-color{style: "font-size: 15px;" } 
                        📍 #{@user.ubication.complete_name}
              
        .flex
            .stat
                .number
                    = @user.registered_concerts.size
                .name
                    = link_to diary_registered_concerts_path(user_id: @user.id) do
                        = Concert.plural
            
            .stat
                .number
                    = @user.registered_concerts.joins(:concert).where("EXTRACT(YEAR FROM concerts.date) = ?", Date.current.year).size
                .name
                    = link_to registered_concerts_path(user_id: @user.id) do
                        = t("this_year")
            .stat
                .number
                    = @user.followers.users.size
                .name
                    = link_to followers_user_path(user_id: @user.id) do
                        = t("followers")
            .stat
                .number
                    = @user.followings.users.size
                .name
                    = link_to followings_user_path(user_id: @user.id) do
                        = t("following")                                

    %div{style: "display:flex; align-items:center; gap:8px; padding-top: 10px;"}

        - if current_user && current_user.id!=@user.id
            %span{ style: "margin-left: auto; background: #1f252b;", class: "soft-color"}
                - if current_user.follows_user?(@user.id)
                    = link_to t("verbs.unfollow"), unfollow_user_path(@user.id), class: "btn-custom", style: "background: #7034a1", data: { turbo_method: :delete }
                - else
                    = link_to t("verbs.follow"), follow_user_path(@user.id), class: "btn-custom", data: { turbo_method: :post }
                %span{style: "margin-left: 10px;"}= t("follows_you")

            

.separator{style: "background: #40556d; "}

