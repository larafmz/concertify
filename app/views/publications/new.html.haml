= turbo_frame_tag "modal" do
  = tag.dialog class: "custom_modal", data: { controller: "dialog" } do

    .modal_header
      %h5= t("crud.add", model: Publication.singular)
      %button.modal_close{ data: { action: "dialog#close" }, style: "color: var(--main-text-color);" } ×

    .modal_body
      = form_with model: @publication, data: { turbo: false } do |f|

        = hidden_field_tag :ticketmaster_id, params[:ticketmaster_id]
        = f.hidden_field :event_id, value: params[:event_id] if @publication.event_id.nil?
        = f.hidden_field :user_id, value: current_user&.id

        .info

          .link_icon{style: "background: var(--darker-second-text-color)"}
            - if current_user.icon.attached?
              = image_tag current_user.icon
            - else
              = current_user.username.first.upcase

          .form-columns{data: { controller: "character-counter" }}
            = f.text_area :review, required: true, maxlength: 500, placeholder: t("messages.whats_going_on"), id: "review_id", class: "register-form-input register-form-textarea", data: { character_counter_target: "input", action: "input->character-counter#update" }

            .register-form-counter
              %span{data: { character_counter_target: "counter" }}

        .widget-content{data: { controller: "max-files" }}
          = f.file_field :photos, class: "register-form-input register-form-file", multiple: true, accept: "image/*", id: "photos_id", data: { controller: "max-files", max_files: Publication::MAX_PHOTOS, max_files_message: t("messages.max_upload", count: Publication::MAX_PHOTOS), action: "change->max-files#change" }

        .register-form-actions
          = f.submit t("verbs.post"), class: "register-form-submit orange-color"