= render "users/options", active: :follows if @user

.widget-content{style: "padding-top:0px;"}  

    %div{style: "display: flex; gap: 20px; color: white;"}
        = link_to followings_user_path(@user.id), title: "#{@followings.count} #{User.plural}" do
            =t("following").upcase
            (#{@followings.count})
        = link_to followers_user_path(@user.id), style: ("color: white; border-bottom: 2px solid #eb5d25;"), title: "#{@followers.count} #{User.plural}" do
            =t("followers").upcase
            (#{@followers.count})
        = link_to blocked_user_path(@user.id), title: "#{@blocked.count} #{User.plural}" do
            =t("blocked").upcase
            (#{@blocked.count})

    .separator

.widget-content{style: "padding-top:0px;"}  
    - if @followers.empty?
        .message
            ℹ️
            = t("not_found_model", model: User.plural.downcase )
    - else
        %div{style: "border: 1px solid #40556d;"}       
            .registers-items
                = render "users/index", users: @followers 