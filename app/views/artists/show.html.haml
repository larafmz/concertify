
= render "artists/header"

= render "artists/options", active: :events

.widget-content{style: "color: #a4b3c4; padding-top: 0px;"}

    .section-box{style: "margin-top:0px;"}
        .title
            #{Event.plural.upcase} • #{@events.size} #{t("results").upcase}
        = render "events/filters", search_by_name: false
        .separator{style: "margin-bottom: 15px; "}
        = render "events/index", events: @events[0,10]

    - if current_user
        .section-box
            = render "events/manual_add"
        
           