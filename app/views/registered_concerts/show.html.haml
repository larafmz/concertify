.widget-content
    .register-show
        = link_to concert_path(@concert.id) do 
            .rectangle_icon{ style: "border: 1px solid " }
                = image_tag @concert.photo if @concert.photo.attached?
            
        .register-info
            %div
                =t("registers.logged_by")
                = link_to user_path(@user.id), class: "undecored_link" do 
                    %span{style: "font-weight: 700"}=@user.username.upcase

            .separator{style: "background: rgb(78, 77, 102); margin: 10px 0;"}

            = link_to concert_path(@concert.id) do 
                %span{ style: "font-size: 28px; font-weight: 600;" }= @concert.tour_name
                
            - if @artist.genre && @artist.genre.name!="Undefined"
                %span{ style: "font-size: 18px; font-weight: 200;" }=" -  #{@artist.genre.name}"

            .softest-color{style: "font-size: 15px;" }
                %span= "📍#{@concert.ubication&.complete_name} 🗓️ #{short_date(@concert.date)}" 

            %div{style: "color: orange"}= @register.get_rating
            
            - if !@register.review.empty?
                %div{ style: "word-break: break-word; overflow-wrap: break-word; padding: 15px; margin: 10px 0; background: rgb(53, 53, 70);" }
                    = @register.review

            %div{style: "margin-bottom: 40px;"}
                - heart = @register.likes.count == 0 ? "♡" : "❤"
                .soft-color{style: "font-size: 15px;"}
                    - if !current_user || (current_user.id == @register.user.id)
                        = heart
                    - else
                        = link_to like_interactuable_path(@register.id), data: { turbo_method: :post } do 
                            = heart
                    - if @register.likes.count == 0
                        = t("registers.no_likes_yet")
                    - else
                        = link_to likes_interactuable_path(@register.id) do 
                            = @register.likes.count
                            = Like.plural

            .soft-color{style: "margin: 10px 0;"}
                = link_to user_path(current_user.id), class: "undecored_link" do 
                    %span{style: "font-weight: 700"}=@user.username.upcase
                =t("registers.liked_these_reviews")
                .separator{style: "background: rgb(78, 77, 102);"}
                (TO/DO)

        - if current_user && current_user.id == @register.user_id
            .dropdown
                %button.btn.btn-secondary.dropdown-toggle{
                    type: "button",
                    "data-bs-toggle" => "dropdown",
                    "aria-expanded" => "false"
                }
                    =t("verbs.edit")
                %ul.dropdown-menu
                    %li
                        = link_to t("crud.edit", model: RegisteredConcert.singular), edit_registered_concert_path(id: @register.id), data: { turbo_frame: "modal" }, class: "dropdown-item"
                    %li
                        = link_to t("crud.destroy", model: RegisteredConcert.singular), registered_concert_path(@register), data: { turbo_method: :delete, turbo_confirm: "¿Esta seguro de que desea eliminar el registro?" }, class: "dropdown-item"

    
    .soft-color{style: "margin-top: 20px;"}
        =link_to artists_path do
            = @register.comments.count
            = Comment.plural.upcase
        .separator{style: "background: #40556d; margin-bottom: 15px; "}