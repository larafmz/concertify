- registered_concerts[0..9].each do |register|
    .review
        .small_icon 
            = register.user.id
        %div
            %div
                %span{style: "font-weight: 700", class: "soft-color"} Review by 
                = link_to user_path(current_user.id) do 
                    %span{style: "font-weight: 700"}=current_user.username.upcase
                %span{style: "color: orange"}= register.get_rating
            %div
                =register.review

                        