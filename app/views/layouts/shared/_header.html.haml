.header
  .logo
    = link_to root_path do
      = image_tag("icon_logo.png", alt: t("root_title"))
  .app_name
    = link_to root_path do
      Concertify

  = form_tag "/searchs", method: "GET" do
    = text_field_tag :search, nil, placeholder: "🔍 #{t("search")}", class: "field-custom"


  - if !current_user
    = link_to "Iniciar sesión", new_user_session_path, class: "btn-custom"
    = link_to "Crear cuenta", new_user_registration_path, class: "btn-custom"
  - else 
    .dropdown
      %button.btn.btn-secondary.dropdown-toggle{
        type: "button",
        "data-bs-toggle" => "dropdown",
        "aria-expanded" => "false"
      }
        Opciones

      %ul.dropdown-menu
        %li
          = link_to "Perfil TO/DO", "#", class: "dropdown-item"
        %li
          = link_to "Mis Conciertos Registrados", registered_concerts_path(user_id: current_user.id), class: "dropdown-item"
        %li
          = link_to "Mis Futuros Conciertos", future_assistances_path(user_id: current_user.id), class: "dropdown-item"
        %li
          %hr.dropdown-divider
        %li
          = link_to "Seguidores (TO/DO)", "#", class: "dropdown-item"
        %li
          = link_to "Seguidos (TO/DO)", "#", class: "dropdown-item"
        %li
          %hr.dropdown-divider          
        %li
          = link_to "Cerrar sesión (TO/DO)", "#", class: "dropdown-item"
