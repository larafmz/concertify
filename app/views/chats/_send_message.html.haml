= form_tag send_message_chat_path(user_id: @user&.id, event_id: @event&.id), method: :post, data: { turbo: false } do
    %div{style: "border-radius: 15px; border: 1px solid #40556d; display:flex; height:70px; padding: 10px; margin:10px;"}
        = text_area_tag :message, nil, maxlength: 500, placeholder: t("send_a_message"), 
            style: "outline:none; color: white; border: none; background:none; width: 100%; height: 100%; resize: none;",
            data: { controller: "send-message", action: "keydown->send-message#submit" }
        %div{style: "display: flex; justify-content: flex-end; margin: 5px;"}
            = submit_tag "➤", class: "btn-custom-orange"