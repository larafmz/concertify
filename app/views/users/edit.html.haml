.widget-content

    %h4{style: "color: white;"}= t("account_configuration")
    = form_with model: @user do |f|

        - if @user.errors.any?
            .form-errors
                - @user.errors.full_messages.each do |message|
                    ● #{message}
                    %br
    
        .two-columns{style: "gap: 20px;"}


            .section-box
                %h6{class: "soft-color"}= t("profile")

                = label_tag :username, User.human_attribute_name(:username), class: "soft-color", style: "font-size: 13px;"
                = f.text_field :username, class: "field-custom"
                %br  
                %br  

                = label_tag :email, User.human_attribute_name(:email), class: "soft-color", style: "font-size: 13px;"
                = f.text_field :email, class: "field-custom"
                %br   
                %br  

                %div{id: "ubication"}
                    = f.fields_for :ubication do |ubication_fields|
                        .two-columns{style: "gap: 20px;"}
                            %div
                                = label_tag :country_id, "📍  #{Country.singular} *", class: "soft-color", style: "font-size: 13px;"
                                = ubication_fields.select :country_id, options_for_select(Country.all.map { |country| [t(country.name), country.id] }, 
                                    @user.ubication&.country_id), { include_blank: "Seleccionar" }, { class: "field-custom", style: "padding: 0px;" }
                                
                            %div
                                = label_tag :city, "📍 #{Ubication.human_attribute_name(:city)}", class: "soft-color", style: "font-size: 13px;"
                                = ubication_fields.text_field :city, value: @user.ubication&.city, class: "field-custom"
                        %br   
                

                .form-columns{data: { controller: "character-counter" }}
                    %div
                        = label_tag :description, User.human_attribute_name(:description), class: "soft-color", style: "font-size: 13px;"
                        = f.text_area :description, placeholder: t("crud.add", model: User.human_attribute_name(:description)), maxlength: 500, style: "width: 100%; height: 100px; resize: none;", class: "field-custom", data: {  character_counter_target: "input", action: "input->character-counter#update" }
                    %div
                        %br
                        %span{data: { character_counter_target: "counter" }, style: "text-align: right; font-size: 12px; color: #a4b3c4;"}

            
            %div
                .section-box
                    %h6{class: "soft-color"}= t("profile_icon")
                    %br  
                    - if @user.icon.attached?
                        .div
                            .circle_icon
                                = image_tag @user.icon
                            .delete-image-option
                                = check_box_tag :remove_icon, "1", false
                                = label_tag :remove_icon, t("destroy_actual_icon")
            
                    %br  
                    %br  
                    
                    = f.file_field :icon


        = f.submit t("verbs.save"), style: "float: right", class: "btn-custom orange-color", style: "height: auto"

    = button_to t("verbs.destroy_my_account"), user_registration_path, method: :delete, data: { turbo_confirm: "¿Seguro que quieres eliminar tu cuenta?" }, class: "btn-custom", style: "background: red; float: right;"
