- @event = Event.find(register.event_id)
- @artist = @event.artists.first
.register-show
    = link_to event_path(@event) do 
        .rectangle_icon{ style: "border: 1px solid " }
            = image_tag @event.get_photo if @event.get_photo&.attached?
        
    .register-info
        .title_section
            .flex-left
                = link_to user_path(@user), class: "hover-border-icon" do
                    .link_icon{style: "width: 25px; height: 25px;"}
                        = image_tag  @user.icon if @user.icon.attached?
                = t("registers.logged_by")
                = link_to user_path(@user), class: "undecored_link" do 
                    %span{style: "font-weight: 700"}=@user.username.upcase
            - if can?(:update, register)
                .dropdown
                    %button.btn.btn-secondary.dropdown-toggle{
                        type: "button",
                        "data-bs-toggle" => "dropdown",
                        "aria-expanded" => "false",
                        style: "background: #{orange_color};"
                    }
                        =t("verbs.edit")
                    %ul.dropdown-menu
                        %li
                            = link_to t("crud.edit", model: Register.singular), edit_register_path(register), data: { turbo_frame: "modal" }, class: "dropdown-item"
                        %li
                            = link_to t("crud.destroy", model: Register.singular), interactuable_path(register), data: { turbo_method: :delete, turbo_confirm: t("registers.destroy_message") }, class: "dropdown-item"


        .separator{style: "margin: 10px 0;"}

        = link_to event_path(@event) do 
            %span{ style: "font-size: 28px; font-weight: 600;" }= @event.tour_name
            
        - if @artist && @artist.genre && @artist.genre.name!="Undefined"
            %span{ style: "font-size: 18px; font-weight: 200;" }=" -  #{@artist.genre.name}"

        .softest-color{style: "font-size: 15px;" }
            %span= "📍#{@event.ubication&.complete_name} 🗓️ #{short_date(@event.date)}" 

        %div{style: "color: orange"}= register.get_rating
        
        - unless register.review.blank?
            %div{ style: "word-break: break-word; overflow-wrap: break-word; padding: 15px; margin: 10px 0; background: rgb(53, 53, 70);" }
                = register.review

        - if register.photos.attached?
            .register-photos            
                - register.photos.each do |photo|
                    = link_to rails_blob_path(photo, disposition: "inline"), target: "_blank", rel: "noopener" do
                        = image_tag photo, class: "register-photo"

        %div{style: "margin: 20px 0px 40px 0px;"}
            = render "interactuables/footer", interactuable: register

        - unless @liked_by_creator.empty?
            .soft-color{style: "margin: 10px 0;"}
                = link_to user_path(@user) do 
                    %span{style: "font-weight: 700"}=@user.username.upcase
                =t("registers.liked_these_reviews")
                .separator
                - @liked_by_creator.each do |register_liked|
                    = link_to comments_interactuable_path(register_liked), class: "hover-border-icon" do
                        .link_icon
                            = image_tag  register_liked.user.icon if register_liked.user.icon.attached?

