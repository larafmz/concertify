= render "artists/header"
= render "artists/options", active: :publications

.widget-content{style: "padding-top: 0px;"}
    - if can?(:post, @artist)
        .separator{style: "margin-bottom: 15px;"}
        %div
            = form_tag post_artist_path(@artist), method: :post, data: { turbo: false } do
                %div{data: { controller: "character-counter" }, style: "margin:15px; display: grid; grid-template-columns: auto 1fr auto; color: var(--main-text-color); gap: 10px; "}
                    %div
                        = link_to user_path(current_user), class: "hover-border-icon",style: "display: block;" do 
                            .link_icon{style: "background:var(--darker-second-text-color)"}
                                - if current_user.icon.attached?
                                    = image_tag current_user.icon
                                - else
                                    = current_user.username.first.upcase
                    = text_area_tag :text, nil, maxlength: 500, placeholder: t("messages.post_about", model: @artist.name), id: "post_text_id", required: true,                       
                        oninput: "this.setCustomValidity(this.value.trim() === '' ? #{t('messages.fill_this_field').to_json} : '')",
                        style: "outline:none; color: var(--main-text-color); border: none; background:none; width: 100%; height: 50px; resize: none;",
                        data: { character_counter_target: "input", action: "input->character-counter#update" }
                    %div{data: { character_counter_target: "counter" }, style: "text-align: right; font-size: 12px; color: var(--soft-color);"}
                %div{style: "display: flex; justify-content: flex-end; margin: 10px;"}
                    = submit_tag t("verbs.post"), class: "btn-custom artist-color"
        .separator{style: "margin-bottom: 15px;"}
    = render "publications/index", publications: @publications