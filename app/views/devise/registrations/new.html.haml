.auth-page-background
  .auth-form-card
    %h4.auth-form-title= t("user_account.register")

    = form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
      .auth-form-fields

        = render "common/error_messages", resource: resource

        = f.hidden_field :role_id, value: Role.get_user_role.id

        .auth-form-field
          = f.label :username, User.human_attribute_name(:username), class: "auth-form-label"
          = f.text_field :username, class: "auth-form-input", id: "username_id"

        .auth-form-field
          = f.label :email, User.human_attribute_name(:email), class: "auth-form-label"
          = f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-form-input", id: "email_id"

        .auth-form-field
          = f.label :password, User.human_attribute_name(:password), class: "auth-form-label"
          - if @minimum_password_length
            %em.auth-form-hint
              = "(#{t("user_account.minimum_password_length", count: @minimum_password_length)})"
          = f.password_field :password, autocomplete: "new-password", class: "auth-form-input", id: "password_id"

        .auth-form-field
          = f.label :password_confirmation, t("user_account.password_confirmation"), class: "auth-form-label"
          = f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-form-input", id: "password_confirmation_id"

      = f.submit t("user_account.register"), class: "auth-form-submit"