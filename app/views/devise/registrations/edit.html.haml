.profile-edit-page
  .profile-edit-card

    %h4.profile-edit-title= t("account_configuration")

    = form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f|
      = render "common/error_messages", resource: @user

      .profile-edit-columns

        .profile-edit-section
          %h6.profile-edit-section-title= t("user_account.profile")

          .profile-edit-field
            = f.label :username, User.human_attribute_name(:username), class: "profile-edit-label"
            = f.text_field :username, class: "profile-edit-input", autocomplete: "username", id: "username_id", maxlength: 20

          .profile-edit-field
            = f.label :email, User.human_attribute_name(:email), class: "profile-edit-label"
            = f.email_field :email, autofocus: true, autocomplete: "email", class: "profile-edit-input", id: "email_id"

          %div{id: "ubication"}
            = f.fields_for :ubication do |ubication_fields|
              .profile-edit-location
                .profile-edit-field
                  = label_tag :country_id, "📍  #{Country.singular} *", class: "profile-edit-label"
                  = ubication_fields.select :country_id, options_for_select(Country.all.sort_by(&:translation).map { |country| [country.translation, country.id] }, @user.ubication&.country_id), { include_blank: t("verbs.select") }, { id: "country_id", class: "profile-edit-input profile-edit-select" }

                .profile-edit-field
                  = label_tag :city, Ubication.human_attribute_name(:city), class: "profile-edit-label"
                  = ubication_fields.text_field :city, value: @user.ubication&.city, class: "profile-edit-input", id: "city_id", autocomplete: "city"

          .profile-edit-description{data: { controller: "character-counter" }}
            .profile-edit-field
              = label_tag :description, User.human_attribute_name(:description), class: "profile-edit-label"
              = f.text_area :description, placeholder: t("crud.add", model: User.human_attribute_name(:description)), maxlength: 500, id: "description_id", class: "profile-edit-input profile-edit-textarea", autocomplete: "description", data: { character_counter_target: "input", action: "input->character-counter#update" }

            %div.profile-edit-counter
              %span{data: { character_counter_target: "counter" }}

        .profile-edit-side

          .profile-edit-section
            %h6.profile-edit-section-title= t("profile_icon")

            .profile-edit-avatar-upload
              = f.file_field :icon, class: "profile-edit-input profile-edit-file"

              - if @user.icon.attached?
                .profile-edit-avatar
                  = image_tag @user.icon

          .profile-edit-section
            %h6.profile-edit-section-title= t("user_account.change_password")

            .profile-edit-field
              = f.label :password, User.human_attribute_name(:password), class: "profile-edit-label"
              - if @minimum_password_length
                %span.profile-edit-hint
                  = "(#{t("user_account.minimum_password_length", count: @minimum_password_length)})"
              = f.password_field :password, autocomplete: "new-password", class: "profile-edit-input"

            .profile-edit-field
              = f.label :password_confirmation, t("user_account.password_confirmation"), class: "profile-edit-label"
              = f.password_field :password_confirmation, autocomplete: "new-password", class: "profile-edit-input"

            .profile-edit-field
              = f.label :current_password, User.human_attribute_name(:current_password), class: "profile-edit-label"
              %span.profile-edit-hint
                = t("user_account.need_current_password_to_confirm")
              = f.password_field :current_password, autocomplete: "current-password", class: "profile-edit-input"

      .profile-edit-actions
        = f.submit t("verbs.save"), class: "profile-edit-save"

    .profile-edit-danger
      = button_to t("user_account.destroy_my_account"), registration_path(resource_name), data: { confirm: t("user_account.sure_to_delete_account"), turbo_confirm: t("user_account.sure_to_delete_account") }, method: :delete, class: "profile-edit-delete"