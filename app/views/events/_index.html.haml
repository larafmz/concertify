.events-items
    - if events.empty? 
        .message
            ℹ️
            = t("not_found_model", model: Event.plural.downcase )
    - else
        - events.each_with_index do |item, index|
            - event = item[:event]
            - event_date = item[:date]
            - event_time = item[:time]

            .item-event

                .date-event
                    = I18n.l(event_date, format: "%B")[0,3].upcase
                    %br
                    %span{style: "font-size:20px;"}= event_date.day
                    %br
                    - if event_date.year != Date.today.year
                        = event_date.year

                - if photo
                    - if item[:source] == :api
                        = link_to event_path(id: "ticketmaster", ticketmaster_id: get_event_id(event)), class: "hover-border-icon" do
                            .link_icon{style: "height: 80px; width: 100px; border-radius: 0%;"}
                                = image_tag get_event_image_url(event)
                    - else
                        = link_to event_path(event) do
                            .link_icon{style: "height: 80px; width: 100px; border-radius: 0%;"}
                                = image_tag event.photo if event.photo.attached?

                .event-info
                    %span.soft-color
                        = wday_time(event_date, event_time)
                    %br
                    %span{style: "font-weight:600"}
                        - if item[:source] == :db
                            = link_to event_path(event) do
                                = event.tour_name
                        - else
                            = link_to event_path(id: "ticketmaster", ticketmaster_id: get_event_id(event)) do
                                = get_event_name(event)
                    %br
                    %span.soft-color
                        - if item[:source] == :db
                            = event.ubication&.complete_name_with_venue
                        - else
                            = get_full_ubication(event)

                - if current_user
                    - if item[:source] == :db
                        = render "events/assistance_buttoms", event: event
                    - else  
                        .button-event
                            - event_date_status = time_status(event_date, event_time)
                            - if event_date_status == "past"
                                - register = Register.joins(:event).where(user_id: current_user&.id, events: { ticketmaster_id: event["id"] }).first
                                - if register
                                    = link_to t("my_model", model: Register.singular), interactuable_path(id: register.id), class: "btn-custom", style: "height: auto;"
                                - else
                                    = link_to t("registers.assisted"), new_register_path(ticketmaster_id: event["id"]), class: "btn-custom-orange", data: { turbo_frame: "modal" }
                            - elsif event_date_status == "future"
                                - future_assistance = FutureAssistance.joins(:event).where(user_id: current_user&.id, events: { ticketmaster_id: event["id"] }).first
                                - if future_assistance
                                    = link_to t("my_model", model: FutureAssistance.singular), future_assistances_user_path(current_user&.id), class: "btn-custom", style: "height: auto;"
                                - else
                                    = link_to t("registers.will_assist"), new_future_assistance_path(ticketmaster_id: event["id"]), class: "btn-custom-orange", data: { turbo_frame: "modal" }
                
            - if index != events.count-1
                .separator