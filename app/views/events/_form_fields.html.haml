.nested-fields
    .form-modal-info

        .soft-color
            = t("details_of", data: Event.singular ).upcase

        .two-columns
            %div
                = label_tag :artist_id, "🧑‍🎤 #{Artist.singular} *", class: "soft-color", style: "font-size: 13px;"
                = f.text_field :artist_name, 
                    value: @event.artists.first&.name || Artist.find_by(id: params[:artist_id])&.name,
                    placeholder: "Ex: Taylor Swift", class: "field-custom", list: "artists-list"
                %datalist#artists-list
                    - Artist.all.sort_by(&:name).each do |artist|
                        %option{ value: artist.complete_name }

            %div
                = label_tag :tour_name, "🎶 #{Event.human_attribute_name(:tour_name)}", class: "soft-color", style: "font-size: 13px;"
                = f.text_field :tour_name, placeholder: "Ej: Eras Tour", class: "field-custom"

        .two-columns
            %div
                = label_tag :date, "🗓️  #{Event.human_attribute_name(:date)} *", class: "soft-color", style: "font-size: 13px;"
                = f.date_field :date, class: "field-custom"
            %div
                = label_tag :start_time, "🕐 #{Event.human_attribute_name(:start_time)}", class: "soft-color", style: "font-size: 13px;"
                = f.time_field  :start_time, class: "field-custom"


        .separator{style: "margin-top:10px"}
        
        .soft-color
            = t("details_of", data: Ubication.singular ).upcase

        = f.fields_for :ubication do |ubication_fields|
            .nested-fields
                .three-columns{style: "gap: 20px;"}
                    %div
                        = label_tag :venue, "#{Ubication.human_attribute_name(:venue)}", class: "soft-color", style: "font-size: 13px;"
                        = ubication_fields.text_field :venue, class: "field-custom", placeholder: "Ex: WiZink Center"

                    %div
                        = label_tag :city, "📍 #{Ubication.human_attribute_name(:city)}", class: "soft-color", style: "font-size: 13px;"
                        = ubication_fields.text_field :city, class: "field-custom", placeholder: "Ex: Madrid"
                    %div
                        = label_tag :country, "📍  #{Country.singular} *", class: "soft-color", style: "font-size: 13px;"
                        = ubication_fields.select :country_id, options_for_select(Country.all.map { |country| [t(country.name), country.id] }, @event.ubication&.country_id), { include_blank: t("verbs.select") }, { class: "field-custom", style: "padding: 0px;" }