= turbo_frame_tag "modal" do
  = tag.dialog class: "custom_modal", data: { controller: "dialog" } do

    .modal_header
      %h5= t("registers.i_assisted_to")
      %button.modal_close{ data: { action: "dialog#close" } } ×

    .modal_body
      = form_with model: @register, data: { turbo: false } do |f|
        
        = hidden_field_tag :ticketmaster_id, params[:ticketmaster_id]
        = f.hidden_field :event_id, value: params[:event_id] if @register.event_id.nil?
        = f.hidden_field :user_id, value: current_user&.id
        
        .form-modal

          .rectangle_icon
            - if @event_api
              = image_tag get_event_image_url(@event_api)
            - else
              = image_tag  @event.photo if @event.photo.attached?

          .form-modal-info

            %span{ style: "font-size: 20px;" }
              - if @event_api
                = get_event_name(@event_api)
              - else
                = @event.tour_name

            %span{ style: "font-size: 13px;" }
              - if @event_api
                = "#{get_full_ubication(@event_api)} - #{get_event_date(@event_api).strftime("%d %B %Y")}"
              - else
                = "#{@event.ubication.complete_name} - #{short_date(@event.date)}"

            .separator

            .form-columns{data: { controller: "character-counter" }}
              %div
                = label_tag :review, "Reseña:", class: "soft-color", style: "font-size: 13px;"
                = f.text_area :review, placeholder: "Añadir reseña", maxlength: 500, placeholder: t("messages.write_your_review"), class: "field-custom", style: "width: 100%; height: 100px; resize: none;", data: {  character_counter_target: "input", action: "input->character-counter#update" }
              %div
                %br
                %span{data: { character_counter_target: "counter" }, style: "text-align: right; font-size: 12px; color: #a4b3c4;"}
            
            .rating
              %div= label_tag :rating, "Rating:", class: "soft-color", style: "font-size: 13px;"
              - (1..5).each do |i|
                = f.radio_button :rating, i
                = f.label :"rating_#{i}" do
                  - (1..i).each do 
                    ★
        %br
        = f.submit "Guardar", style: "float: right"