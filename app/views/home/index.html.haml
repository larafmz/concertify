.widget-content.list

  .section-box
    %h4{style: "padding-bottom: 15px"}
      #{Artist.plural.upcase} #{t("populars").upcase} (#TO/DO filtrar por mas seguidores)

    .items
      = render "artists/index_db", artists: @artists_db

  .section-box
    %h4{style: "padding-bottom: 15px"}
      =Concert.plural.upcase
    - if current_user && !current_user.followings.artists.empty? & !@concerts_following_db&.empty?
      %h5
        =t("from_followed_artists")
      .section-box
        = render "concerts/index", concerts_db: @concerts_following_db, concerts_api: []
    %h5
      =t("recently_added")
    .section-box
      = render "concerts/index", concerts_db: @concerts_db, concerts_api: []
  