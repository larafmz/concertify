.big-second-column{style: "height: calc(100vh - 120px); overflow:hidden; min-height: 0;"}
    
    = render "chats/sidebar", chats: @chats

    = turbo_frame_tag "chat_content", style: "border-left:1px solid var(--second-text-color); display:flex; flex-direction:column; height:100%; min-height:0; overflow:hidden; " do
        = render "chats/header", chat: @chat, user: @user, event: @event

        .chat-container
            - if @chat_entries
                = render "chat_entries/index", chat_entries: @chat_entries

        - if @chat && can?(:send_message, @chat) && (@user || @event)
            = render "chats/send_message"
        - else
            %div{style: "border-radius: 15px; border: 1px solid var(--second-text-color); height:70px; padding: 10px; margin:10px;"}
                %div{style: "display: flex; align-items: center; justify-content: center; height: 100%; color: var(--main-text-color);"}
                    = t("messages.cant_send_message")