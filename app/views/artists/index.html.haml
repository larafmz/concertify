%div{ style: "background: #1f252b;color: white; font-family: Georgia, 'Times New Roman', Times, serif; font-size: 25px; padding: 5px 0px 0px 50px;" }
    = link_to @event.tour_name, event_path( @event.id) if @event
    = link_to @artist.name, artist_path( @artist.id) if @artist
    = t("populars", model: Artist.plural)

.separator{style: "margin-bottom: 15px; "}

.widget-content{style: "padding-top: 0px;"}
    - if @artists.empty?
        .message
            ℹ️
            = t("not_found_model", model: Artist.plural.downcase )
    .artists-index{style: "color:#e9e9e9; "}

        - @artists[0..48].each do |artist|
            %div
                %div{ style: "height:10px;"}    

                = link_to artist_path(artist.id), class: "hover-border-icon" do
                    .link_icon{style: "width: 120px; height: 120px;"}
                        = image_tag  artist.photo, class: "artist-avatar" if artist.photo.attached?
                
                .artist-name{ style: " font-size: 13px; width: 120px; display: flex;  justify-content: center; text-align: center;"}    
                    = link_to artist_path(artist.id) do
                        = artist.name