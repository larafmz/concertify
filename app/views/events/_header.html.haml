%div{ style: "position: relative; padding: 0px 70px 10px 0px; background-image: url('#{url_for(@event.get_photo)}'); background-size: cover; background-position: center 30%;" }
    %div{ style: "position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 60%, #1f252b 100%), linear-gradient(to right, rgba(15, 20, 25, 1) 0%, rgba(15, 20, 25, 0.7) 25%, rgba(15, 20, 25, 0) 60%);" }
    .artist-content{ style: "position: relative; z-index: 1;" }
        .artist-info{style:"margin:40px;"}
            .artist-name
                .adapted-bubble.event-color
                    ="##{Event.singular.upcase}"
                    - if current_user&.admin? && @event.request
                        = @event.request.status_string.upcase
                %div= @event.tour_name
                %div{ style: "font-size: 15px; margin-bottom:5px" }
                    %div= "📍#{@event.ubication&.complete_name} "
                %div{ style: "font-size: 15px;" }
                    %div= "🗓️ #{formatted_event_date(@event.date, @event.start_time)}" 
             
    %div{style: "display:flex; align-items:center; width:100%; padding-top:10px; position: relative;"}
        .flex{ style: " width: 20%;" }
            - event_date_status = time_status(@event.date, @event.start_time)
            - if event_date_status == "past" && !@registers.empty?
                .stat
                    .number
                        ★ #{@average_rating} / 5
                    .name{style: "color: white"}
                        = t("average", model: Register.plural)

        %span{ style: "margin-left: auto; margin-bottom: 25px;" }
            = render "events/assistance_buttoms", event: @event
