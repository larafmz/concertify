.header
  .logo
    = link_to root_path do
      = image_tag("icon_logo.png", alt: t("root_title"))
  .app_name
    = link_to root_path do
      Concertify

  = form_tag "/searchs", method: "GET" do
    = text_field_tag :search, params[:search], placeholder: "🔍 #{t("main_search")}", class: "field-custom"

  %div
    - if !current_user
      = link_to t("verbs.login"), new_user_session_path, class: "btn-custom-orange"
      = link_to t("verbs.log"), new_user_registration_path, class: "btn-custom-orange"
    - else  
      %div{style: "display: flex; gap: 10px;"}
        .dropdown
          %button.btn.btn-secondary.dropdown-toggle{
            type: "button",
            "data-bs-toggle" => "dropdown",
            "aria-expanded" => "false",
            style: "background: #eb5d25" 
          }
            + #{t("crud.create", model: "")}

          %ul.dropdown-menu
            %li
              = link_to Publication.singular, new_publication_path, class: "dropdown-item", data: { turbo_frame: "modal" }

        .dropdown
          %button.btn.btn-secondary.dropdown-toggle{
            type: "button",
            "data-bs-toggle" => "dropdown",
            "aria-expanded" => "false",
            style: "background: #eb5d25" 
          }
            =t("crud.show", model: "")

          %ul.dropdown-menu
            %li
              = link_to Event.plural,events_path, class: "dropdown-item"
            %li
              = link_to Register.plural, registers_path, class: "dropdown-item"
            %li
              = link_to Publication.plural, publications_path, class: "dropdown-item"
            %li
              = link_to Artist.plural, artists_path, class: "dropdown-item"

        - if current_user.admin?
          .dropdown
            %button.btn.btn-secondary.dropdown-toggle{
              type: "button",
              "data-bs-toggle" => "dropdown",
              "aria-expanded" => "false",
              style: "background: #eb5d25" 
            }
              =t("admin")

            %ul.dropdown-menu
              %li
                = link_to t("requested_events"), requests_events_path, class: "dropdown-item"            


  - if current_user
    .flex{style: "display: flex; justify-content: right; gap: 30px; padding: 10px; font-size: 18px; color: white; "}
      = link_to user_path(current_user), class: "hover-border-icon", title: t("profile") do
        .link_icon{ class: ("active" if current_page?(user_path(current_user))) }
          👤
      = link_to notifications_path, class: "hover-border-icon", title: Notification.plural do
        = render "layouts/shared/notifications_bubble"

      = link_to chats_path, class: "hover-border-icon", title: Chat.plural do
        = render "layouts/shared/messages_bubble"


  .dropdown
    %button.btn.btn-secondary.dropdown-toggle{
      type: "button",
      "data-bs-toggle" => "dropdown",
      "aria-expanded" => "false",
      style: "background: #51485a" 
    }
      =t("options")

    %ul.dropdown-menu
      %li
        = link_to t("switch_to", model: t("spanish")), change_locale_path(:es), class: "dropdown-item"
      %li
        = link_to t("switch_to", model: t("english")), change_locale_path(:en), class: "dropdown-item"
      - if current_user
        %li
          %hr.dropdown-divider
        %li
          = link_to t("verbs.logout"), "#", class: "dropdown-item"

.separator{style: "background: #40556d; "}
