.widget-content.list
    %h2{ style: "color: white;" } Conciertos registrados de #{current_user.email} #TO/DO username
    .section-box
        .registers-items
            - @registered_concerts.each do |register|
                - concert = register.concert
                - concert_date = concert.date
                .item-register
                    .date-concert{ style: "color: black;"}
                        = concert_date.strftime("%B")[0,3].upcase
                        %br
                        %span{ style: "font-size: 20px;" }= concert_date.day
                        %br
                        - if concert_date.year != Date.today.year
                            = concert_date.year
                    = link_to concert_path(concert.id) do 
                        .rectangle_icon{ style: "height: 90px; width: 150px; border: 1px solid " }
                            = image_tag concert.photo if concert.photo.attached?
                    %div
                        = link_to registered_concert_path(register.id) do 
                            %span{ style: "font-size: 20px;" }= concert.tour_name
                        %br
                        %span{ class: "soft-color" }= concert.ubication.complete_name
                    %div{style: "color: orange"}= register.get_puntuation
                    - if register.user_id = current_user.id
                        .button-concert
                            = link_to "✎", edit_registered_concert_path(id: register.id), data: { turbo_frame: "modal" }
                    

