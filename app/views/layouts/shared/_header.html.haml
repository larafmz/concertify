.header
  .logo
    = link_to root_path do
      = image_tag("icon_logo.png", alt: t("root_title"))
  .app_name
    = link_to root_path do
      Concertify

  = form_tag "/searchs", method: "GET" do
    = text_field_tag :search, params[:search], placeholder: "🔍 #{t("main_search")}", class: "field-custom"

  - if !current_user
    = link_to t("verbs.login"), new_user_session_path, class: "btn-custom"
    = link_to t("verbs.register"), new_user_registration_path, class: "btn-custom"

  .dropdown
    %button.btn.btn-secondary.dropdown-toggle{
      type: "button",
      "data-bs-toggle" => "dropdown",
      "aria-expanded" => "false",
      style: "background: #eb5d25;"
    }
      + Crear
 
    %ul.dropdown-menu
      %li
        = link_to t("crud.add", model: RegisteredConcert.singular), searchs_path, class: "dropdown-item"
      %li
        %hr.dropdown-divider         
      %li
        = link_to  t("verbs.request", model: Concert.singular), new_concert_path, data: { turbo_frame: "modal" }, class: "dropdown-item"


  - if current_user
    .flex{style: "display: flex; justify-content: right; gap: 30px; padding: 10px; font-size: 18px; color: white; "}
      = link_to user_path(current_user), class: "hover-border-icon" do
        .header_icon{ class: ("active" if current_page?(user_path(current_user))) }
          👤
      = link_to "#", class: "hover-border-icon" do
        .header_icon{ class: ("active" if current_page?("#")) }
          🔔
      = link_to "#", class: "hover-border-icon" do
        .header_icon{ class: ("active" if current_page?("#")) }
          💬

    .dropdown
      %button.btn.btn-secondary.dropdown-toggle{
        type: "button",
        "data-bs-toggle" => "dropdown",
        "aria-expanded" => "false"
      }
        Opciones

      %ul.dropdown-menu
        %li
          = link_to t("verbs.logout"), "#", class: "dropdown-item"
        %li
          %hr.dropdown-divider     
    
  %div{style: "display: flex; gap: 30px; font-size: 25px;"}
    = link_to "ES", change_locale_path(:es)
    = link_to "EN", change_locale_path(:en)

.separator{style: "background: #40556d; "}
