.header
  .logo
    = link_to root_path do
      = image_tag("icon_logo.png", alt: t("root_title"))
  .app_name
    = link_to root_path do
      Concertify

  = form_tag "/searchs", method: "GET" do
    = text_field_tag :search, params[:search], placeholder: "🔍 #{t("search")}", class: "field-custom"

  - if !current_user
    = link_to t("verbs.login"), new_user_session_path, class: "btn-custom"
    = link_to t("verbs.register"), new_user_registration_path, class: "btn-custom"
  - else 
    .dropdown
      %button.btn.btn-secondary.dropdown-toggle{
        type: "button",
        "data-bs-toggle" => "dropdown",
        "aria-expanded" => "false"
      }
        Opciones

      %ul.dropdown-menu
        %li
          = link_to t("profile"), user_path(current_user.id), class: "dropdown-item"
        %li
          = link_to t("my_model_plural", model: RegisteredConcert.plural), registered_concerts_path, class: "dropdown-item"
        %li
          = link_to t("my_model_plural", model: FutureAssistance.plural), future_assistances_path, class: "dropdown-item"
        %li
          %hr.dropdown-divider
        %li
          = link_to t("my_model_plural", model: t("requested_concerts")), requested_concerts_path, class: "dropdown-item"
        %li
          = link_to t("my_model_plural", model: t("requested_artists")), requested_artists_path, class: "dropdown-item"
        %li
          %hr.dropdown-divider
        %li
          = link_to t("followers"), "#", class: "dropdown-item"
        %li
          = link_to t("follows"), "#", class: "dropdown-item"
        %li
          %hr.dropdown-divider          
        %li
          = link_to t("verbs.logout"), "#", class: "dropdown-item"

  - if current_user
    %div{style: "display: flex; gap: 30px; font-size: 25px;"}
      = link_to "🔔", "#", style: "text-decoration: none;"
      = link_to "💬", "#", style: "text-decoration: none;"
      = link_to "✒️", "#", style: "text-decoration: none;"
    
  %div{style: "display: flex; gap: 30px; font-size: 25px;"}
    = link_to "ES", change_locale_path(:es)
    = link_to "EN", change_locale_path(:en)