= turbo_frame_tag "modal" do
  = tag.dialog class: "custom_modal", data: { controller: "dialog" } do

    .modal_header
      Asistiré a...
      %button.modal_close{ data: { action: "dialog#close" } } ×

    .modal_body
      = form_with model: @future_assistance, data: { turbo: false } do |f|
        
        = f.hidden_field :concert_id
        = f.hidden_field :user_id, value: current_user&.id
        
        .form-register

          .rectangle_icon
            = image_tag  @concert.photo if @concert.photo.attached?

          .register_info
            %span{ style: "font-size: 20px;" }= @concert.tour_name
            %span{ style: "font-size: 13px;" }= "#{@concert.ubication.complete_name} - #{@concert.date.strftime("%d %B %Y")}"
            %div
              = f.check_box :alone
              = f.label :alone, "Voy solo"
            Ubicación en el concierto:
            %span{ style: "display: grid; grid-template-columns: 1fr 3fr; gap: 10px" }
              = f.select :concert_seat, FutureAssistance.concert_seats_for_select, prompt: "Seleccionar..."
              = f.text_field :concert_seat_details, placeholder: "Detalles de la Ubicación"

        %br
        = f.submit "Guardar", style: "float: right"