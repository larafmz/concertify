- background = notification.read? ? "inherit" : "#30363d"
%div{style: "background: #{background}; display: grid; grid-template-columns: auto 1fr auto auto; gap: 25px; align-items: center; border-bottom: 1px solid #40556d; padding: 5px 40px 5px 40px; "}
    - user = notification.user
    %div
        - if user
            = link_to user_path(user.id), class: "hover-border-icon" do
                .link_icon
                    = image_tag user.icon if user.icon.attached?
    = link_to notification.path, class: "publication-link", style: "display: grid; grid-template-columns: 1fr auto;" do
        %div
            %div{style: "font-size: 15px ; color: white;"}
                = notification.message.html_safe
            %div.softest-color
                = custom_time_ago_in_words(notification.created_at)
        %div
            - if notification.icon
                .link_icon{style:  "width: 45px; height: 45px; border-radius: 20%; "}
                    = image_tag notification.icon if notification.icon.attached?
        
    %div
        - if notification.for_follow?
            = render "users/relation_bottoms", user: user

    - if !notification.read?
        = link_to "👁", mark_as_read_notification_path(notification.id), data: { turbo_method: :post }
