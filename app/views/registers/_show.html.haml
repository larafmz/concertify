- @event = Event.find(register.event_id)
- @artist = @event.artists.first

.register-show
  .register-show-header
    = link_to event_path(@event), class: "register-show-image-link" do
      .register-show-image
        - if @event.get_photo&.attached?
          = image_tag @event.get_photo

    .register-show-info
      .register-show-top
        .register-show-user
          = link_to user_path(@user), class: "register-show-avatar-link" do
            .register-show-avatar
              - if @user.icon.attached?
                = image_tag @user.icon

          %span.register-show-logged-by
            = t("registers.logged_by")

          = link_to user_path(@user), class: "register-show-username" do
            = @user.username.upcase

        - if can?(:update, register)
          .dropdown
            %button.btn.btn-secondary.dropdown-toggle{
              type: "button",
              "data-bs-toggle" => "dropdown",
              "aria-expanded" => "false"
            }
              = t("verbs.edit")

            %ul.dropdown-menu
              %li
                = link_to t("crud.edit", model: Register.singular),
                  edit_register_path(register),
                  data: { turbo_frame: "modal" },
                  class: "dropdown-item"

              %li
                = button_to t("crud.destroy", model: Register.singular), interactuable_path(register), method: :delete,
                  form: { data: { turbo: false, confirm: t("registers.destroy_message") } },
                  class: "dropdown-item"

      .register-show-separator

      %span.register-show-event-name
        = link_to event_path(@event), class: "register-show-event-link" do
          = @event.tour_name

      - if @artist && @artist.genre && @artist.genre.name != "Undefined"
        %span.register-show-genre
          = " - #{@artist.genre.translation}"

      .register-show-details
        %span.register-show-detail
          = image_tag("icon_ubication_softest_color.png")
          %span
            = @event.ubication&.complete_name || t("not_found")

        %span.register-show-detail
          = image_tag("icon_date_softest_color.png")
          %span
            = short_date(@event.date)

      - if register.rating
        .register-show-rating
          = register.get_rating

      - unless register.review.blank?
        .register-show-review
          = simple_format(register.review)

      - if register.photos.attached?
        .register-show-photos
          - register.photos.each do |photo|
            = link_to rails_blob_path(photo, disposition: "inline"), target: "_blank", rel: "noopener", class: "register-show-photo-link" do
              .register-photo
                = image_tag photo

      .register-show-footer
        = render "interactuables/footer", interactuable: register

      - unless @liked_by_creator.empty?
        .register-show-liked
          = link_to user_path(@user), class: "register-show-liked-user" do
            = @user.username.upcase

          %span
            = t("registers.liked_these_reviews")

          .register-show-liked-separator

          .register-show-liked-list
            - @liked_by_creator.each do |register_liked|
              = link_to comments_interactuable_path(register_liked),
                class: "register-show-liked-item" do
                .register-show-liked-avatar
                  - if register_liked.user.icon.attached?
                    = image_tag register_liked.user.icon