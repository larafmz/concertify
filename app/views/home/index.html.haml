.widget-content{style: "color: #a4b3c4;"}
  #{Artist.plural.upcase} #{t("populars").upcase} (TO/DO filtrar por mas seguidores)
  .separator{style: "background: #40556d; margin-bottom: 15px; "}
  .items
    = render "artists/index_db", artists: @artists_db.first(10)

  %br

  - if current_user
    =Concert.plural.upcase 
    =t("recents").upcase
    =t("from_followed_artists").upcase
    .separator{style: "background: #40556d; margin-bottom: 15px; "}
    - if current_user && !current_user.followings.artists.empty? & !@concerts_following_db&.empty?
      .section-box
        = render "concerts/index", concerts_db: @concerts_following_db.limit(5), concerts_api: []

  =Concert.plural.upcase 
  =t("recently_added").upcase
  .separator{style: "background: #40556d; margin-bottom: 15px; "}
  .section-box
    = render "concerts/index", concerts_db: @concerts_db.limit(5), concerts_api: []
  