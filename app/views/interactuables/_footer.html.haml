.soft-color{style: "font-size: 15px; gap:30px; display: flex; align-items: center;"}
    = render "interactuables/like", interactuable: interactuable

    %div{style: "display:flex; align-items:center; gap:5px;"}
        = link_to comments_interactuable_path(interactuable), style: "display:flex; width:fit-content;" do
            = image_tag("icon_comment.png", style: "width:20px; height:20px; display:block;")
        - if interactuable.comments.count != 0
            = interactuable.comments.count

    = render "interactuables/repost", interactuable: interactuable
