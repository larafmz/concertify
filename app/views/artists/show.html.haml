
%div{ class: "widget-content", style: "background: #1f252b;"}
    %div{ class: "artist-content", style: "background: #1f252b;"}
        .artist-info
            .user_icon
                = image_tag  @artist.photo, class: "artist-avatar" if @artist.photo.attached?
                
            .artist-name
                = @artist.name
                - if @artist.genre
                    %span{ style: "color: #696969; font-size: 15px" }
                        = @artist.genre.name

        .flex
            .stat
                .number
                    =  @registered_concerts.count
                .name
                    = link_to registered_concerts_path(artist_id: @artist.id) do   
                        = t("totals", model: RegisteredConcert.plural)
            
            .stat
                .number
                    ★ #{@artist.average_puntuation} / 5
                .name
                    = t("average", model: RegisteredConcert.plural)
            .stat
                .number
                    (TO/DO)
                .name
                    =Publication.plural
                    

    - if current_user
        %div{ style: "justify-self: end; background: #1f252b;" }


    %div{style: "display:flex; align-items:center; gap:8px; padding-top: 10px;"}

        - if current_user
            %span{ style: "margin-left: auto; background: #1f252b;" }
                - if current_user.follows_artist?(@artist.id)
                    = link_to t("verbs.unfollow"), unfollow_artist_path(@artist.id), class: "btn-custom", style: "background: #7034a1", data: { turbo_method: :delete }
                - else
                    = link_to t("verbs.follow"), follow_artist_path(@artist.id), class: "btn-custom", data: { turbo_method: :post }
                - if current_user.favorite_artist?(@artist.id)
                    = link_to "❤ #{t("verbs.unmark_as_favorite")}", unmark_as_favorite_artist_path(@artist.id), class: "btn-custom", style: "background: #7397da", data: { turbo_method: :delete }
                - elsif current_user.can_mark_favorite?
                    = link_to "♡ #{t("verbs.mark_as_favorite")}", mark_as_favorite_artist_path(@artist.id), class: "btn-custom", style: "background: #da7395", data: { turbo_method: :post }

                 

.separator{style: "background: #40556d; "}

.widget-content{style: "color: #a4b3c4;"}

    = link_to registered_concerts_path(artist_id: @artist.id), style: "text-decoration:none; " do   
        =RegisteredConcert.han("reviews").upcase 
        =t("populars").upcase
        (TO/DO)
    .separator{style: "background: #40556d; margin-bottom: 15px; "}
    - if @reviews.empty?
        = t("not_found_model", model: RegisteredConcert.han("reviews").downcase )
    = render "registered_concerts/reviews", registered_concerts: @reviews

    
    .section-box{style: "margin-top: 50px;"}
        .title
            #{Concert.plural.upcase} • #{@concerts_api.size + @concerts_db.size} #{t("results").upcase}
        = render "concerts/filters", search_by_name: false
        = render "concerts/index", concerts_db: @concerts_db, concerts_api: @concerts_api

    .section-box
        = render "concerts/manual_add"
        
           