= turbo_frame_tag "modal" do
  = tag.dialog class: "custom_modal", data: { controller: "dialog" } do

    .modal_header
      Asistí a...
      %button.modal_close{ data: { action: "dialog#close" } } ×

    .modal_body
      = form_with model: @registered_concert, data: { turbo: false } do |f|
        
        = f.hidden_field :ticketmaster_id, value: params[:concert_id]
        = f.hidden_field :user_id, value: current_user&.id
        
        .form-register

          .rectangle_icon
            = image_tag  @concert.photo if @concert.photo.attached?

          .register_info
            %span{ style: "font-size: 20px;" }= @concert.tour_name
            %span{ style: "font-size: 13px;" }= "#{@concert.ubication.complete_name} - #{@concert.date.strftime("%d %B %Y")}"
            = f.text_area :text, placeholder: "Añadir reseña", style: "width: 100%; height: 100px; resize: vertical;"
            .rating
              %div="Rating"
              - (1..5).each do |i|
                = f.radio_button :rating, i
                = f.label :"rating_#{i}" do
                  - (1..i).each do 
                    ★
        %br
        = f.submit "Guardar", style: "float: right"