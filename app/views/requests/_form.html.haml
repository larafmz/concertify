= turbo_frame_tag "modal" do
  = tag.dialog class: "custom_modal", data: { controller: "dialog" }, style: "background: #1e2731;" do

    .modal_header
      %div
        %h5=t("crud.add", model: Event.singular)
        - if @request.requester&.username && @request.created_at
          .soft-color{style: "font-size: 13px;"}
            = t("sent_ago_by", user: @request.requester.username , time: time_ago_in_words(@request.created_at))
      %button.modal_close{ data: { action: "dialog#close" } } ×

    = form_with model: @request, data: { turbo: false } do |f|
      .modal_body
        
        - unless @request.requester_id.present?
          = f.hidden_field :requester_id, value: current_user&.id
        = f.hidden_field :status, value: 1
        
        .form-modal

          .form-modal-info


            %div{id: "event"}
              = f.fields_for :event do |event_fields|
                = render "events/form_fields", f: event_fields

            - if current_user.admin? && @request.persisted?
              .separator{style: "margin-top:10px;"}

              .two-columns
                %div
                
                  = label_tag :status, Request.human_attribute_name(:status).upcase, class: "soft-color", style: "font-size: 13px;"
                  = f.select :status, options_for_select(Request.statuses_for_select, @request.status), {}, { class: "field-custom", style: "padding: 0px;" }
                %div
                
                  = label_tag :message, Request.human_attribute_name(:message).upcase, class: "soft-color", style: "font-size: 13px;"
                  = f.text_field :message, class: "field-custom"

              .separator{style: "margin-top:10px;"}
              = label_tag :existing_event_id, t("messages.exists_in_app_already").upcase, class: "soft-color", style: "font-size: 13px;"
              = f.select :existing_event_id, 
                options_for_select(Array(@request.matching_events).sort_by(&:tour_name).map { |event| [event.complete_info, event.id] }, 
                @request.existing_event_id), { include_blank: t("verbs.select") }, { class: "field-custom", style: "padding: 0px;" }

      %div
        = f.submit t("verbs.save"), style: "float: right; height: auto;", class: "btn-custom-orange"