.widget-content{style: "color: #a4b3c4; background: #1f252b; display: flex; justify-content: left; gap: 60px; padding: 0px 0px 0px 90px;"}
    = link_to Concert.plural, artist_path(@artist), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :concerts)
    = link_to RegisteredConcert.plural, registers_artist_path(@artist), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :registers)
    = link_to Publication.plural, publications_artist_path(@artist), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :publications)
    = link_to t("followers"), followers_artist_path(@artist), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :followers)
.separator{style: "margin-bottom:20px;"}