- registers[0..9].each do |register|
    .review
        = link_to user_path(register.user), class: "hover-border-icon" do
            .link_icon 
                - if register.user.icon.attached?
                    = image_tag register.user.icon
                - else
                    = register.user.username.first.upcase
        %div
            %div
                %span{style: "font-weight: 700", class: "soft-color"} Review by 
                = link_to user_path(register.user) do 
                    %span{style: "font-weight: 700"}=register.user.username.upcase
                %span{style: "color: orange"}= register.get_rating
            %div
                =register.review

                        