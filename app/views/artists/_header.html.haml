.widget-content{style: "background: #1f252b;"}
    .artist-content
        .artist-info
            .user_icon
                = image_tag  @artist.photo, class: "artist-avatar" if @artist.photo.attached?
                
            .artist-name
                = @artist.name
                - if @artist.genre && @artist.genre.name != "Undefined"
                    .softest-color{ style: "font-size: 15px" }
                        = @artist.genre.name

        .flex
            .stat
                .number
                    =  @artist.relations.count
                .name
                    = link_to followers_artist_path(@artist) do   
                        = t("followers")
            
            .stat
                .number
                    ★ #{@artist.average_rating} / 5
                .name
                    = t("average", model: Register.plural)
                    
    %div{style: "display:flex; align-items:center; gap:8px; padding-top: 10px;"}

        - if current_user
            %span{ style: "display: flex; margin-left: auto; background: #1f252b; gap:10px;" }
                - if current_user.follows_artist?(@artist.id)
                    = button_to t("following"), unfollow_artist_path(@artist), class: "btn-custom", method: :delete, form: { data: { turbo: false } }
                - else
                    = button_to t("verbs.follow"), follow_artist_path(@artist.id), class: "btn-custom-orange", method: :post, form: { data: { turbo: false } }
                - if current_user.favorite_artist?(@artist.id)
                    = link_to "♡ #{t("verbs.unmark_as_favorite")}", unmark_as_favorite_artist_path(@artist.id), class: "btn-custom", data: { turbo_method: :delete }
                - elsif current_user.can_mark_favorite?
                    = button_to "♡ #{t("verbs.mark_as_favorite")}", mark_as_favorite_artist_path(@artist.id), class: "btn-custom-orange", method: :post, form: { data: { turbo: false } }
                - else
                    = button_to "♡ #{t("verbs.mark_as_favorite")}", mark_as_favorite_artist_path(@artist.id), class: "btn-custom-orange", method: :post, form: { data: { turbo: false, controller: "alert", action: "click->alert#show", alert_message_value: t("messages.cant_mark_as_favorite") } }
                 
