- background = notification.read? ? "var(--notification-read)" : "var(--notification-unread)" 
- user = notification.user

.notification{id: "notification-#{notification.id}", style: "background: #{background};"}

  .notification-user
    - if user
      = link_to user_path(user), class: "notification-user-link" do
        .link_icon{style: "background: var(--darker-second-text-color)"}
          - if user.icon.attached?
            = image_tag user.icon
          - else
            = user.username.first.upcase

  = button_to read_and_redirect_notification_path(notification), class: "notification-main", method: :post, form: { data: { turbo: false } } do

    .notification-content
      .notification-message
        = notification.message.html_safe

      .notification-time
        = custom_time_ago_in_words(notification.created_at)

    - icon = notification.icon
    - if icon
      .notification-icon
        = image_tag icon

  - if notification.for_follow?
    .notification-actions
      = render "users/relation_buttons", user: user

  - unless notification.read?
    = link_to "✓", mark_as_read_notification_path(notification), data: { turbo_method: :post }, class: "notification-read-button"