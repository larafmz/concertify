.widget-content{style: "background: var(--background); color: var(--soft-color); display: flex; justify-content: center; gap: 60px; padding: 10px; "}
    = link_to users_path(search: params[:search]), style: ("color: var(--main-text-color); border-bottom: 2px solid #{orange_color};" if active == :users) do
        %i.fa-solid.fa-users
        = User.plural 
    = link_to events_path(search: params[:search]), style: ("color: var(--main-text-color); border-bottom: 2px solid #{orange_color};" if active == :events) do
        %i.fa-solid.fa-music
        = Event.plural
    = link_to artists_path(search: params[:search]), style: ("color: var(--main-text-color); border-bottom: 2px solid #{orange_color};" if active == :artists) do
        %i.fa-solid.fa-guitar
        = Artist.plural 

.separator
