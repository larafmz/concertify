= render "users/options", active: :artists if @user

.widget-content{style: "padding-top:0px;"}  

    - if !@user
        %div{style: "margin-top: 20px;"}

            %div{ style: "color: white; font-family: Georgia, 'Times New Roman', Times, serif; font-size: 25px;" }
                = t("populars", model: Artist.plural)

            .separator{style: "margin-bottom: 15px; "}

    - if @favorites&.empty? && @artists.empty?
        .message
            ℹ️
            = t("not_found_model", model: Artist.plural.downcase )
            = t("following").downcase

    .artists-index{style: "color:#e9e9e9; "}
        - @favorites&.each do |artist|
            %div

                %div{ style: "height:10px; font-size: 13px; width: 120px; display: flex;  justify-content: center;"}    
                    ❤ 

                = link_to artist_path(artist.id), class: "hover-border-icon" do
                    .link_icon{style: "width: 120px; height: 120px;"}
                        = image_tag  artist.photo, class: "artist-avatar" if artist.photo.attached?
                
                .artist-name{ style: "  font-size: 13px; width: 120px; display: flex;  justify-content: center;"}    
                    = link_to artist_path(artist.id) do
                        =artist.name


        - @artists[0..48].each do |artist|
            %div
                %div{ style: "height:10px;"}    

                = link_to artist_path(artist.id), class: "hover-border-icon" do
                    .link_icon{style: "width: 120px; height: 120px;"}
                        = image_tag  artist.photo, class: "artist-avatar" if artist.photo.attached?
                
                .artist-name{ style: "  font-size: 13px; width: 120px; display: flex;  justify-content: center;"}    
                    = link_to artist_path(artist.id) do
                        = artist.name