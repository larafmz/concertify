= turbo_frame_tag "modal" do
  = tag.dialog class: "custom_modal", data: { controller: "dialog" } do

    .modal_header
      %h5 #{t("registers.will_assist")}...
      %button.modal_close{ data: { action: "dialog#close" } } ×

    .modal_body
      = form_with model: @future_assistance, data: { turbo: false } do |f|
        
        = hidden_field_tag :ticketmaster_id, params[:ticketmaster_id]
        = f.hidden_field :event_id, value: params[:event_id] if @future_assistance.event_id.nil?
        = f.hidden_field :user_id, value: current_user&.id
        
        .form-modal

          .rectangle_icon
            - if @event_api
              = image_tag get_event_image_url(@event_api)
            - else
              = image_tag  @event.get_photo if @event.get_photo.attached?

          .form-modal-info
            %span{ style: "font-size: 20px;" }
              - if @event_api
                = get_event_name(@event_api)
              - else
                = @event.tour_name

            %span{ style: "font-size: 13px;" }
              - if @event_api
                = "#{get_full_ubication(@event_api)} - #{get_event_date(@event_api).strftime("%d %B %Y")}"
              - else
                = "#{@event.ubication.complete_name} - #{short_date(@event.date)}"

            .separator

            %div
              = label_tag :from, FutureAssistance.human_attribute_name(:from), class: "soft-color", style: "font-size: 13px;"
              = f.text_field :from, placeholder: FutureAssistance.human_attribute_name(:from), class: "field-custom"
         
            = label_tag :event_seat, FutureAssistance.human_attribute_name(:event_seat), class: "soft-color", style: "font-size: 13px;"          
            %span{ style: "display: grid; grid-template-columns: 1fr 3fr; gap: 10px" }
              = f.select :event_seat, FutureAssistance.event_seats_for_select, prompt: "Seleccionar...", class: "field-custom"
              = f.text_field :event_seat_details, placeholder: FutureAssistance.human_attribute_name(:event_seat_details), class: "field-custom"

            %div
              = label_tag :company, FutureAssistance.human_attribute_name(:company), class: "soft-color", style: "font-size: 13px;"
              = f.select :company, FutureAssistance.companies_for_select, class: "field-custom"

        %br
        = f.submit t("verbs.save"), style: "float: right", class: "btn-custom-orange", style: "height: auto"