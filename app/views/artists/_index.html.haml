- if artists.empty?
    = render "common/empty_list_message", model: Artist
-else 
    .artists-index{style: "color:#e9e9e9; "}
        - artists.each do |item|
            - artist = item[:source].present? ? item[:artist] : item

            %div
                - if !item[:source] || item[:source] == :db
                    - if artist.is_favorite?(current_user)
                        %div{ style: "height:10px; font-size: 13px; width: 120px; display: flex;  justify-content: center;"}    
                            ❤ 
                    - else
                        %div{ style: "height:10px;"}    
  
                    = link_to artist_path(artist), class: "hover-border-icon" do
                        .link_icon{style: "width: 120px; height: 120px;"}
                            = image_tag  artist.photo if artist.photo.attached?
                                
                    .artist-name{ style: " font-size: 13px; width: 120px; display: flex;  justify-content: center; text-align: center;"}    
                        = link_to artist_path(artist) do
                            = artist.name                                
                - else  
                    = link_to artist_path(id: "ticketmaster", ticketmaster_id: artist.dig("id")), class: "hover-border-icon" do
                        .link_icon{style: "width: 120px; height: 120px;"}
                            = image_tag  best_quality_image(artist.dig("images")).dig("url")

                    .artist-name{ style: " font-size: 13px; width: 120px; display: flex;  justify-content: center; text-align: center;"}    
                        = link_to artist_path(id: "ticketmaster", ticketmaster_id: artist.dig("id")) do
                            = artist.dig("name")      

    = paginate artists                 