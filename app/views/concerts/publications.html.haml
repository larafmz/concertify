= render "concerts/header"
= render "concerts/options", active: :publications
.widget-content{style: "padding-top: 0px;"}
    - if current_user
        .separator{style: "margin-bottom: 15px;"}
        %div
            = form_tag post_concert_path(@concert), method: :post, data: { turbo: false } do
                %div{data: { controller: "character-counter" }, style: "margin:15px; display: grid; grid-template-columns: auto 1fr auto; color: white; gap: 10px; "}
                    %div
                        = link_to user_path(current_user.id), class: "hover-border-icon",style: "display: block;" do 
                            .link_icon
                                = image_tag current_user.icon if current_user.icon.attached?
                    = text_area_tag :text, nil, maxlength: 500, placeholder: t("messages.post_about", model: @concert.tour_name), style: "outline:none; color: white; border: none; background:none; width: 100%; height: 50px; resize: none;", data: {  character_counter_target: "input", action: "input->character-counter#update" }
                    %div{data: { character_counter_target: "counter" }, style: "text-align: right; font-size: 12px; color: #a4b3c4;"}
                %div{style: "display: flex; justify-content: flex-end; margin: 10px;"}
                    = submit_tag t("verbs.post"), class: "btn-custom-orange"
        .separator{style: "margin-bottom: 15px;"}
    = render "publications/index", publications: @publications