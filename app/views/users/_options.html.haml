.widget-content{style: "color: #a4b3c4; "}

    .widget-content{style: "display: flex; justify-content: center; gap: 60px; padding: 10px; border: 1px solid #263241;"}
        = link_to @user.username, user_path(@user), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :profile)
        = link_to RegisteredConcert.han("reviews"), registered_concerts_path(user_id: @user.id), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :reviews)
        = link_to t("diary"), diary_registered_concerts_path(user_id: @user.id), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :diary)
        = link_to FutureAssistance.plural, future_assistances_path(user_id: @user.id), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :future_assistances)
        = link_to t("likes"), "#", style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :likes)
        = link_to Artist.plural, artists_path(user_id: @user.id), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :artists)
        = link_to t("requests"), requested_concerts_path(user_id: current_user.id), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :requests)