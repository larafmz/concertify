.widget-content{style: "color: #a4b3c4;"}

  - if @registers.present?
    %div{style: "margin-top: 20px;"}
      .title_section
        =link_to registers_path do
          =t("recents", model: Register.plural).upcase
        =link_to registers_path do
          = t("more").upcase
      .separator{style: "margin-bottom: 15px; "}
      = render "registers/index_cards", registers: @registers.limit(6)
    
  - if @publications.present?
    %div{style: "margin-top: 20px;"}
      .title_section
        =link_to publications_path do
          =t("recents", model: Publication.plural).upcase
        =link_to publications_path do
          = t("more").upcase
      .separator{style: "margin-bottom: 15px; "}
      = render "publications/index", publications: @publications.limit(3)

  %div{style: "margin-top: 20px;"}
    .title_section
      =link_to artists_path do
        = t("populars", model: Artist.plural).upcase
      =link_to artists_path do
        = t("more").upcase
    .separator{style: "margin-bottom: 15px; "}
    .items
      = render "artists/index_cards", artists: @artists


  %div{style: "margin-top: 20px;"}
    .title_section
      =link_to events_path(country: current_user&.ubication&.country&.code) do
        =t("upcoming").upcase
        =Event.plural.upcase
        - if current_user && current_user&.ubication&.country
          = t("in").upcase
          = t(current_user.ubication.country.name).upcase
      =link_to events_path(country: current_user&.ubication&.country&.code) do
        = t("more").upcase
    .separator{style: "margin-bottom: 15px; "}
    - unless @events.empty?
      .section-box
        = render "events/index", events: @events, photo: false
        