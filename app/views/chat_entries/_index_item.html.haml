.chat_entry
    - if chat_entry.show_date_separator?
        .soft-color{style: "display:flex; justify-content:center; font-size:13px;"}
            = short_date(chat_entry.created_at)

    - if chat_entry.chat_type == 0
        - if chat_entry.user_id == current_user.id
            %div{style: "display:flex; justify-content:flex-end;"}
                %div{style: "display:inline-flex; padding:10px; border-radius:15px; border:1px solid var(--second-text-color); margin:5px; background: var(--message)"}
                    %div{style: "overflow-wrap:anywhere; color: var(--main-text-color) "}= chat_entry.text
                    %span{style: "font-size:10px; margin-left: 5px; align-self:flex-end; opacity:0.7; color: var(--main-text-color)"}= chat_entry.created_at.strftime("%H:%M")
        - else 
            %div{style: "display:flex; justify-content:start; align-items:center;"}
                - if (!chat_entry.same_previous_user? || !chat_entry.same_previous_type?) && chat_entry.user
                    = link_to user_path(chat_entry.user), data: { turbo_frame: "_top" } do 
                        .link_icon{style: "height: 40px; width: 40px; background:var(--darker-second-text-color); color: var(--main-text-color)"}
                            - if chat_entry.user.icon.attached?
                                = image_tag chat_entry.user.icon
                            - else
                                = chat_entry.user.username.first.upcase
                - else
                    %div{style: "height: 40px; width: 40px;"}

                %div
                    - if !chat_entry.same_previous_user? || !chat_entry.same_previous_type?
                        %div{style: "margin-left:10px; font-size: 10px;", class: "soft-color"}
                            = chat_entry.user&.username || "NOT FOUND"
                    %div{style: "display:inline-flex; padding:10px; border-radius:15px; border:1px solid var(--second-text-color); margin:5px; background: var(--second-text-color)"}
                        %div{style: "overflow-wrap:anywhere; color: var(--main-text-color) "}= chat_entry.text
                        .soft-color{style: "font-size:10px; margin-left: 5px; align-self:flex-end; opacity:0.7;"}= chat_entry.created_at.strftime("%H:%M")
    - else
        .soft-color{style: "display:flex; justify-content:center; font-size:13px;"}
            - if chat_entry.user_id == current_user.id
                = t("you_#{chat_entry.text}", model: chat_entry.user.username)
            - else
                = t(chat_entry.text, model: chat_entry.user&.username)