= turbo_frame_tag "modal" do
  = tag.dialog class: "custom_modal", data: { controller: "dialog" } do

    .modal_header
      %h5=t("crud.add", model: Publication.singular)
      %button.modal_close{ data: { action: "dialog#close" }, style: "color: white;" } ×

    .modal_body
      = form_with model: @publication, data: { turbo: false } do |f|
        
        = hidden_field_tag :ticketmaster_id, params[:ticketmaster_id]
        = f.hidden_field :concert_id, value: params[:concert_id] if @publication.concert_id.nil?
        = f.hidden_field :user_id, value: current_user&.id
        
        .artist-info

          - if @concert
            .rectangle_icon
              - if @concert_api
                = image_tag get_concert_image_url(@concert_api)
              - else
                = image_tag  @concert.photo if @concert.photo.attached?

              .form-modal-info
                %span{ style: "font-size: 20px;" }
                  - if @concert_api
                    = get_concert_name(@concert_api)
                  - else
                    = @concert.tour_name

              %span{ style: "font-size: 13px;" }
                = "#{@concert.ubication.complete_name} - #{short_date(@concert.date)}"
            .separator

          .link_icon 
            = image_tag current_user.icon if current_user.icon.attached?

          .form-columns{data: { controller: "character-counter" }}
            = f.text_area :review, maxlength: 500, placeholder: t("messages.whats_going_on"), class: "field-custom", style: "width: 100%; height: 150px; resize: none;", data: {  character_counter_target: "input", action: "input->character-counter#update" }

            %div{data: { character_counter_target: "counter" }, style: "text-align: right; font-size: 12px; color: #a4b3c4;"}

        = f.submit t("verbs.post"), style: "float: right; height: auto; margin-top:10px;", class: "btn-custom"
