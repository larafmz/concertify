.title_section{ style: "background: #1f252b;"}
    %div{ style: "color: white; font-family: Georgia, 'Times New Roman', Times, serif; font-size: 25px; padding: 5px 0px 0px 50px; " }
        = Notification.plural
    %div{style: "margin-right: 50px"}
        =link_to t("verbs.mark_all_read"), mark_all_read_notifications_path(user_id: current_user), data: { turbo_method: :post }

.separator

- if @notifications.empty?
    .widget-content
        = render "common/empty_list_message", model: Notification
- else
    .widget-content{style: "padding: 0px;", data: { controller: "pagination", pagination_url_value: url_for(@pagination_path), pagination_page_value: 2 } }
        %div{id: "notifications", data: { pagination_target: "notifications" } }
            - @notifications.each do |notification|  
                = render "notifications/index_item", notification: notification

        - unless @notifications.respond_to?(:next_page) && @notifications.next_page && @pagination_path
            %span{class: "hidden", data: { pagination_target: "noRecords" }}
