= turbo_frame_tag "modal" do
  = tag.dialog class: "custom_modal", data: { controller: "dialog" } do

    .modal_header
      %h5=t("crud.add", model: Publication.singular)
      %button.modal_close{ data: { action: "dialog#close" }, style: "color: white;" } ×

    .modal_body
      = form_with model: @publication, data: { turbo: false } do |f|
        
        = hidden_field_tag :ticketmaster_id, params[:ticketmaster_id]
        = f.hidden_field :event_id, value: params[:event_id] if @publication.event_id.nil?
        = f.hidden_field :user_id, value: current_user&.id
        
        .artist-info

          - if @event
            .rectangle_icon
              - if @event_api
                = image_tag get_event_image_url(@event_api)
              - else
                = image_tag  @event.get_photo if @event.get_photo&.attached?

              .form-modal-info
                %span{ style: "font-size: 20px;" }
                  - if @event_api
                    = get_event_name(@event_api)
                  - else
                    = @event.tour_name

              %span{ style: "font-size: 13px;" }
                = "#{@event.ubication.complete_name} - #{short_date(@event.date)}"
            .separator

          .link_icon 
            = image_tag current_user.icon if current_user.icon.attached?

          .form-columns{data: { controller: "character-counter" }}
            = f.text_area :review, required: true, maxlength: 500, placeholder: t("messages.whats_going_on"), class: "field-custom", style: "width: 100%; height: 150px; resize: none;", data: {  character_counter_target: "input", action: "input->character-counter#update" }

            %div{data: { character_counter_target: "counter" }, style: "text-align: right; font-size: 12px; color: #a4b3c4;"}

        = f.submit t("verbs.post"), style: "float: right; height: auto; margin-top:10px;", class: "btn-custom orange-color"
