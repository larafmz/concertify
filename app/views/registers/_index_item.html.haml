- feed = register
- register = register[:register] if register[:register].present?
- event = register.event

.register-index-item

  - if feed[:repost]
    .register-index-repost
      %span.register-index-repost-icon ↻

      - if feed[:repost].user.id == current_user.id
        = t("verbs.you_reposted")
      - else
        = feed[:repost].user.username
        = " "
        = t("verbs.reposted").downcase

  .register-index-main

    .register-index-user
      = link_to user_path(register.user), class: "register-index-avatar-link" do
        .register-index-avatar
          - if register.user.icon.attached?
            = image_tag register.user.icon
          - else
            = register.user.username.first.upcase

    = link_to comments_interactuable_path(register),
      id: "interactuable_#{register.id}",
      class: "register-index-event-image-link" do

      .register-index-event-image
        - if event.get_photo&.attached?
          = image_tag event.get_photo
        - else
          .register-index-event-placeholder
            🎵

    .register-index-content

      .register-index-user-info
        = link_to user_path(register.user_id), class: "register-index-username" do
          = register.user.username

        %span.register-index-action
          = t("verbs.logged")

      = link_to comments_interactuable_path(register), class: "register-index-event-name" do
        = event.tour_name
      
      %div{style: "display: flex; align-items: center; flex-wrap: wrap; gap: 0;"}
        - event.artists.each_with_index do |artist, index|
          = link_to artist_path(artist), class: "register-index-event-name" do
            %span{style: "font-size: 20px; font-weight: 700;"}= artist.name
          - if index < event.artists.size - 1
            %span{style: "font-size: 20px; font-weight: 700; margin-right: 6px; color: white;"}= ","
      .register-index-details

        %span.register-index-detail
          = image_tag("icon_ubication_softest_color.png")
          = event.ubication&.complete_name_with_venue || t("not_found")

        %span.register-index-detail
          = image_tag("icon_date_softest_color.png")
          = short_date(event.date)

      .register-index-rating
        = register.get_rating

      - if register.review.present?
        .register-index-review
          = simple_format(register.review)

      .register-index-footer
        = render "interactuables/footer", interactuable: register

  .register-index-created
    = t("created_ago", time: time_ago_in_words(register.created_at))

.register-index-separator
