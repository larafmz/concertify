- background = notification.read? ? "inherit" : "#30363d"
%div{style: "background: #{background}; display: grid; grid-template-columns: auto 1fr auto; gap: 25px; align-items: center; border-bottom: 1px solid #40556d; padding: 5px 40px 5px 40px; "}
    = link_to user_path(notification.params[:follower].id), class: "hover-border-icon" do
        .link_icon
            = image_tag notification.params[:follower].icon if notification.params[:follower].icon.attached?
    = link_to notification.params[:path], class: "publication-link", style: "display: grid; grid-template-columns: 1fr auto;" do
        %div
            %div{style: "font-size: 15px ; color: white;"}
                %strong= notification.params[:follower].username
                = notification.message
            %div.softest-color
                = custom_time_ago_in_words(notification.created_at)
        %div
            - if notification.record.respond_to?(:interactuable)          
                .link_icon{style:  "width: 45px; height: 45px; border-radius: 20%; "}
                    = image_tag notification.record.interactuable.photo if notification.record.interactuable.photo.attached?
    - if !notification.read?
        = link_to "👁", mark_as_read_notification_path(notification.id), data: { turbo_method: :post }
