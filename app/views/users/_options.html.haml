.widget-content{style: "color: #a4b3c4; "}

    .widget-content{style: "display: flex; justify-content: center; gap: 60px; padding: 10px; border: 1px solid #263241;"}
        = link_to "👤 #{@user.username}", user_path(@user), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :profile)
        = link_to RegisteredConcert.han("reviews"), registers_user_path(@user), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :reviews)
        = link_to t("diary"), diary_user_path(@user), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :diary)
        = link_to FutureAssistance.plural, future_assistances_user_path(@user), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :future_assistances)
        = link_to Publication.plural, publications_user_path(@user), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :publications)
        = link_to Artist.plural, artists_user_path(@user), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :artists)
        - if @user.id == current_user.id
            = link_to t("requests"), requests_user_path(@user), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :requests)
        = link_to t("network"), followers_user_path(@user), style: ("color: white; border-bottom: 2px solid #eb5d25;" if active == :follows)