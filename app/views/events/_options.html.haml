.separator
- event_date_status = @event.past_or_future
.widget-content{style: "color: #a4b3c4; display: flex; justify-content: left; gap: 60px; padding: 0px 0px 0px 90px;"}
    = link_to Artist.plural, event_path(@event), style: ("color: white; border-bottom: 2px solid #{artist_color};" if active == :artists)
    - if event_date_status == "past"
        = link_to "#{@event_registers_count} #{Register.plural}", registers_event_path(@event), style: ("color: white; border-bottom: 2px solid #{event_color};" if active == :registers)
    - else
        = link_to "#{@event_future_assistances_count} #{FutureAssistance.plural}", future_assistances_event_path(@event), style: ("color: white; border-bottom: 2px solid #{event_color};" if active == :future_assistances)
    = link_to "#{@event_publications_count} #{Publication.plural}", publications_event_path(@event), style: ("color: white; border-bottom: 2px solid #{orange_color};" if active == :publications)
.separator{style: "margin-bottom:20px;"}