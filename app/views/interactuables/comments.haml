- if @user
    - if @interactuable.publication?
        = render "users/options", active: :publications
    - elsif @interactuable.register?
        = render "users/options", active: :reviews
        
.widget-content{style: "padding-top:0px;"}  

    %div{style: "border: 1px solid #40556d;"}

        %div{style: "margin:20px; margin-bottom:0px;"}
            - if @interactuable.register?

                %div{ style: "color: white; font-family: Georgia, 'Times New Roman', Times, serif; font-size: 25px;" }
                    = link_to @interactuable.concert.tour_name, concert_path( @interactuable.concert.id)

                .softest-color{style: "font-size: 15px;" }
                    %span= "📍#{@interactuable.concert.ubication&.complete_name} 🗓️ #{short_date(@interactuable.concert.date)}"           
            
            %div
                = render "publications/show", publication: @interactuable

        %div{style: "display: flex; gap: 20px; color: white; margin-left:20px;"}
            = link_to Like.plural, likes_interactuable_path(@interactuable.id), title: "#{@interactuable.likes.count} #{Like.plural}" 
            = link_to Comment.plural, comments_interactuable_path(@interactuable.id), style: ("color: white; border-bottom: 2px solid #eb5d25;"), title: "#{@interactuable.comments.count} #{Comment.plural}"
        .separator

        
        - if current_user
            %div{style: "border-bottom: 1px solid #40556d;"}
                = form_tag comment_interactuable_path(@interactuable), method: :post, data: { turbo: false } do
                    %div{data: { controller: "character-counter" }, style: "margin:15px; display: grid; grid-template-columns: auto 1fr auto; color: white; gap: 10px; "}
                        %div
                            = link_to user_path(current_user.id), class: "hover-border-icon",style: "display: block;" do 
                                .link_icon
                                    = image_tag current_user.icon if current_user.icon.attached?
                        = text_area_tag :text, nil, maxlength: 500, placeholder: t("messages.write_your_answer"), style: "outline:none; color: white; border: none; background:none; width: 100%; height: 50px; resize: none;", data: {  character_counter_target: "input", action: "input->character-counter#update" }
                        %div{data: { character_counter_target: "counter" }, style: "text-align: right; font-size: 12px; color: #a4b3c4;"}
                    %div{style: "display: flex; justify-content: flex-end; margin: 10px;"}
                        = submit_tag t("verbs.answer"), class: "btn-custom"

        - @comments.each do |comment|
            .artist-info{style: "margin-top:15px; padding-left:15px; padding-right:15px;"}
                = link_to user_path(comment.user_id), class: "hover-border-icon" do
                    .link_icon 
                        = image_tag comment.user.icon if comment.user.icon.attached?

                %div
                    .title_section
                        .soft-color{style: "font-size: 15px;" }
                            = link_to user_path(comment.user_id) do 
                                = comment.user.username
                            •
                            %span{class: "softest-color"}
                                = custom_time_ago_in_words(comment.created_at)

                        - if current_user.id == comment.user_id
                            .dropdown
                                %button{
                                    "data-bs-toggle" => "dropdown",
                                    style: "background: none; border:0px; color: white;"
                                }
                                    ⁝
                                %ul.dropdown-menu
                                    %li
                                        = button_to t("verbs.destroy"), uncomment_interactuable_path(comment_id: comment.id), method: :delete, class: "dropdown-item", form: { data: { turbo: false } }
                    %span{style: "font-size: 15px; color: #dee5eb; overflow-wrap: anywhere;"}= simple_format(comment.text)

                