= turbo_frame_tag "modal" do
  = tag.dialog class: "custom_modal", data: { controller: "dialog" }, style: "background: #1e2731;" do

    .modal_header
      %h5=t("crud.add", model: Event.singular)
      %button.modal_close{ data: { action: "dialog#close" } } ×

    .modal_body
      = form_with model: @event, data: { turbo: false } do |f|
        
        = f.hidden_field :requester_id, value: current_user&.id
        = f.hidden_field :status, value: 1
        
        .form-modal

          .form-modal-info
          
            = label_tag :artist_id, "🧑‍🎤 #{Artist.singular} *", class: "soft-color", style: "font-size: 13px;"
            = f.text_field :artist_name, value: @event.artists.first&.name, placeholder: "Ex: Taylor Swift", class: "field-custom", list: "artists-list"
            %datalist#artists-list
              - Artist.all.sort_by(&:name).each do |artist|
                %option{ value: artist.name }

            = label_tag :tour_name, "🎶 #{Event.human_attribute_name(:tour_name)}", class: "soft-color", style: "font-size: 13px;"
            = f.text_field :tour_name, placeholder: "Ej: Eras Tour", class: "field-custom"

            = label_tag :date, "🗓️  #{Event.human_attribute_name(:date)} *", class: "soft-color", style: "font-size: 13px;"
            = f.date_field :date, class: "field-custom"

            .two-columns{style: "gap: 20px;"}
              %div
                = label_tag :country, "📍  #{Country.singular} *", class: "soft-color", style: "font-size: 13px;"
                = select_tag :country, options_for_select(Country.all.map { |country| [t(country.name), country.code] }, @event.ubication&.country&.code), include_blank: t("verbs.select"), class: "field-custom", style: "padding: 0px;"
              %div
                = label_tag :city, "📍 #{Ubication.human_attribute_name(:city)}", class: "soft-color", style: "font-size: 13px;"
                = text_field_tag :city, @event.ubication&.city, class: "field-custom", placeholder: "Ex: Madrid"

        %br
        = f.submit t("verbs.save"), style: "float: right; height: auto;", class: "btn-custom-orange"