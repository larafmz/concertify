- artists.each do |artist|
    - if  artist.is_a?(Artist)
        = link_to artist_path(artist), class: "hover-border" do
            %div
            .rectangle_icon
                = image_tag artist.photo if artist.photo.present?
            .item-name
                = artist.name
    - else
        = link_to artist_path(id: "ticketmaster", ticketmaster_id: artist.dig("id")), class: "hover-border" do
            %div 
            .rectangle_icon
                = image_tag best_quality_image(artist.dig("images")).dig("url")
            .item-name
                = artist.dig("name")
    