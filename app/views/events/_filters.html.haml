= form_tag request.path, method: "GET" do
    - if search_by_name 
        = text_field_tag :search, params[:search], placeholder: "🔍 #{t("search_event")}", class: "field-custom"
        %br
        %br
    .filters-search
        = hidden_field_tag :artist_id, @artist&.id
        %div
            = label_tag :first_date, class: "soft-color label-filter" do 
                = image_tag("icon_date_soft_color.png")
                = t("filters.from").upcase
            = date_field_tag :first_date, params[:first_date], class: "field-custom", style: "background: #0F1419;", id: "first_date"
        %div
            = label_tag :second_date, class: "soft-color label-filter" do 
                = image_tag("icon_date_soft_color.png")
                = t("filters.to").upcase
            = date_field_tag  :second_date, params[:second_date], class: "field-custom", style: "background: #0F1419;", id: "second_date"
        %div
            = label_tag :country, class: "soft-color label-filter" do 
                = image_tag("icon_ubication_soft_color.png")
                = Ubication.singular.upcase
            = select_tag :country, options_for_select(Country.all.map { |country| [country.translation, country.code] }, params[:country]),include_blank: t("all_fem", model: Ubication.plural), class: "field-custom", style: "background: #0F1419; padding: 0px;"
        %div
            %br  
            = submit_tag t("verbs.filter"), class: "btn-custom event-color"
        %div
            %br  
            = link_to t("verbs.remove_filters"), url_for(params.to_unsafe_h.except(:first_date, :second_date, :country, :search)), class: "btn-custom event-color"
            
