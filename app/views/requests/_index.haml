.widget-content{style: "padding-top:0px;", data: { controller: "pagination", pagination_url_value: url_for(@pagination_path), pagination_page_value: 2 } }
    .registers-items{id: "requests", data: { pagination_target: "requests" }}
        - if requests.empty?
            = render "common/empty_list_message", model: Request
        - else
            - requests.each do |request| 
                = render "requests/index_item", request: request
            
            - unless requests.respond_to?(:next_page) && requests.next_page && @pagination_path
                %span{class: "hidden", data: { pagination_target: "noRecords" }}