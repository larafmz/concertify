.events-items
    - if events.empty? 
        = t("not_found_model", model: Event.plural.downcase )
    - else
        - events.each_with_index  do |event, index|
            .item-event
                - event_date = event.date
                .date-event
                    = I18n.l(event_date, format: "%B")[0,3].upcase
                    %br
                    %span{ style: "font-size: 20px;" }= event_date.day
                    %br
                    - if event_date.year != Date.today.year
                        = event_date.year
                .event-info
                    %span{ class: "soft-color" }
                        = formatted_event_date(event_date, event.start_time)
                    %br               
                    %span{ style: "font-weight: 600" }
                        = link_to event_path(event.id) do 
                            = event.tour_name
                    %br
                    %span{ class: "soft-color" }
                        = event.ubication.complete_name_with_address
                - if current_user
                    .button-event
                        - event_date_status = time_status(event_date, event.start_time)
                        - if event_date_status == "past"
                            - register = Register.find_by(user_id: current_user.id, event_id: event.id)
                            - if !register
                                = link_to t("registers.assisted"), new_register_path(event_id: event["id"]), class: "btn-custom-orange", data: { turbo_frame: "modal" }
                            - else
                                = link_to "✎", edit_register_path(id: register.id), data: { turbo_frame: "modal" }
                        - if event_date_status == "future"
                            - future_assistance = FutureAssistance.find_by(user_id: current_user.id, event_id: event.id )
                            - if !future_assistance
                                = link_to t("registers.will_assist"), new_future_assistance_path(event_id: event["id"]), class: "btn-custom-orange", data: { turbo_frame: "modal" }
                            - else
                                = link_to "✎", edit_future_assistance_path(id: future_assistance.id), data: { turbo_frame: "modal" }

            - if index != events.count-1
                .separator
            