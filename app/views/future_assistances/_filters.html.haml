= form_tag request.path, method: "GET" do
    .filters-sidebar
        %div
            = label_tag :event_seat, class: "soft-color label-filter" do 
                🎟️
                = FutureAssistance.human_attribute_name(:event_seat)
            = select_tag :event_seat, options_for_select(FutureAssistance.event_seats_for_select, params[:event_seat]),include_blank: t("all"), class: "field-custom", style: "background: #0F1419; padding: 0px;"
        
        %div
            = label_tag :from, class: "soft-color label-filter" do 
                📍
                = FutureAssistance.human_attribute_name(:from)
            = select_tag :from, options_for_select(@froms_filters, params[:from]), include_blank: t("all_fem", model: Ubication.plural), class: "field-custom", style: "background: #0F1419; padding: 0px;"
        
        %div
            = label_tag :company, class: "soft-color label-filter" do 
                👥
                = FutureAssistance.human_attribute_name(:company)
            = select_tag :company, options_for_select(FutureAssistance.companies_for_select, params[:company]), include_blank: t("all"), class: "field-custom", style: "background: #0F1419; padding: 0px;"
        %div
            = submit_tag t("verbs.filter"), class: "btn-custom event-color"
        %div 
            = link_to t("verbs.remove_filters"), url_for(params.to_unsafe_h.except(:event_seat, :company, :from)), class: "btn-custom event-color"
            
