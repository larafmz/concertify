.widget-content{style: "padding-top:0px;"}  
    .registers-items

        - if events.empty?
            .message
                ℹ️
                = t("not_found_model", model: t("requested_events").downcase)

        - events.each do |event|
            - artist = event.artists.first
            - event_date = event.date
            - status = event.status
            
            %div{style: "background: #{event.color_request}; border-radius: 15px;"}

                .item-register{  style: "margin-left: 5px;  grid-template-columns: 1fr 4fr 1fr auto;  border-bottom-left-radius: 0px; border-bottom-right-radius:0px; border-bottom: 0px;"}

                    .rectangle_icon{ style: "height:80px; width: 150px;" }
                        - if artist
                            = link_to artist_path(artist.id) do
                                = image_tag artist.photo if artist.photo.attached?

                    %div
                        - if artist
                            - if artist.accepted?
                                = link_to artist_path(artist.id) do
                                    %span{ style: "font-size: 20px; font-weight: 700;" }= artist&.name || t("not_found")
                            - else
                                %span{ style: "font-size: 20px; font-weight: 700;" }= artist&.name || t("not_found")
                            %br

                        %span{ style: "font-size: 18px;", class: "soft-color" } #{event.tour_name}
                        %br

                        - ub = event.ubication&.complete_name || t("not_found")
                        .softest-color{style: "font-size: 15px;" }
                            %span= "📍#{ub} 🗓️ #{short_date(event.date)}" 
                        
                        %span{style: "color: #{event.color_request}; font-size: 16px;"}
                            ● #{event.message_request}

                    %div{ style: "display: flex; flex-direction: column; justify-content: space-between; height: 100%;"}
                        %div{style: "background: #{event.second_color_request}; color: #{event.color_request}; border-radius: 15px; font-size:15px; padding: 5px 10px; " }
                            #{event.emoji_request} #{event.status_string}
                        - if event.requester_id == current_user&.id && event.status == Event::STATUS_PENDING
                            %div{style: "display: flex; gap: 20px;"}
                                = link_to "✎", edit_event_path(id: event.id), data: { turbo_frame: "modal" }
                                = link_to "✗", event_path(event), data: { turbo_method: :delete, turbo_confirm: "¿Esta seguro de que desea eliminar el evento solicitado?" }
                        - elsif event.accepted?
                            = link_to t("crud.show", model: Event.singular), event_path(event), class: "btn-custom-orange", style: "font-size: 13px; width: 150px;"
            

                .sent_at
                    = t("sent_ago", time:  time_ago_in_words(event.created_at))

