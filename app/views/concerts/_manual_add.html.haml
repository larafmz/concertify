- if current_user
    .concert_add
        .two-columns{style: "grid-template-columns: auto 1fr;"}
            %div
                %h5= t("messages.cant_find_concert") 
                .soft-color
                    %h5= t("messages.manual_adition") 
            %span{ style: "margin-left: auto" }
                = link_to "+ #{t("crud.add", model: Concert.singular)}", new_concert_path, class: "btn-custom", data: { turbo_frame: "modal" }
