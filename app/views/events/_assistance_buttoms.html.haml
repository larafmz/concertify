- register = Register.find_by(user_id: current_user&.id, event_id: event.id)
- future_assistance = FutureAssistance.find_by(user_id: current_user&.id, event_id: event.id )
- event_date_status = time_status(event.date, event.start_time)
.button-event{style: "display: flex; gap: 10px;"}
    - if event_date_status == "past" && can?(:create, Register)
        - unless register
            = link_to t("registers.assisted"), new_register_path(event_id: event["id"]), class: "btn-custom event-color", data: { turbo_frame: "modal" }
        - else
            = link_to t("my_model", model: Register.singular), interactuable_path(register), class: "btn-custom", style: "height: auto;"
    - elsif can?(:create, FutureAssistance)
        - unless future_assistance
            = link_to t("registers.will_assist"), new_future_assistance_path(event_id: event["id"]), class: "btn-custom event-color", data: { turbo_frame: "modal" }
        - else
            = link_to t("my_model", model: FutureAssistance.singular), future_assistances_user_path(current_user), class: "btn-custom", style: "height: auto;"


