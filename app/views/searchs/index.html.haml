.widget-content.list
  .card.card-body

    .section-box
      %h2 USUARIOS • #{@users.size} RESULTADOS
      .items
        - @users.each do |user|
          .item-name
            = user.email

    .section-box
      %h2 ARTISTAS • #{@artists.size} RESULTADOS
      .items
        - @artists[0..9].each do |artist|
          = link_to artist_path(artist.dig("id")) do
            .item 
              .rectangle_icon
                = image_tag best_quality_image(artist.dig("images")).dig("url"), class: "artist-avatar"
              .item-name
                = artist.dig("name")

    .section-box
      %h2 CONCIERTOS • #{@concerts_api.size} RESULTADOS
      .concerts-items
        - @concerts_api[0..20].each do |concert|
          .item-concert
            - concert_date = Date.parse(concert.dig("dates", "start", "localDate"))
            .date-concert
              = concert_date.strftime("%B")[0,3].upcase
              %br
              %span{ style: "font-size: 20px;" }= concert_date.day
              %br
              - if concert_date.year == Date.today.year
                = concert_date.year
            .concert-info
              %span{ style: "color: #696969;" }
                = formatted_concert_date(concert_date, concert.dig("dates", "start", "localTime"))
              %br
              #{concert.dig("name")} 
              %br
              %span{ style: "color: #696969;" }
                - venue = concert.dig("_embedded", "venues").first 
                #{venue.dig("city", "name")}, #{venue.dig("state", "name")},  #{venue.dig("country", "name")} • #{venue.dig("address", "line1")}
            - if concert_date < Date.today
              = link_to "He asistido", new_registered_concert_path
            - if concert_date >= Date.today
              = link_to "Asistiré", new_future_assistance_path
         
