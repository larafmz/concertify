
%div{ class: "widget-content", style: "background: #1f252b;"}
    %div{ class: "artist-content", style: "background: #1f252b;"}
        .artist-info
            .circle_icon
                = image_tag  @artist.photo, class: "artist-avatar" if @artist.photo.attached?
                
            .artist-name
                = @artist.name
                - if @artist.genre
                    %span{ style: "color: #696969; font-size: 15px" }
                        = @artist.genre.name

        .artist-stats
            .stat
                .number
                    = @artist.interactuables.register.size
                .name
                    Registros totales
            
            .stat
                .number
                    ★ #{@artist.average_puntuation} / 5
                .name
                    Media de Registros
            .stat
                .number
                    (TO/DO)
                .name
                    Publicaciones

.separator{style: "background: #40556d; "}

.widget-content
    .section-box
        %h2 CONCIERTOS • #{@concerts_api.size} RESULTADOS
        = render "searchs/filters"
        .concerts-items
            = render "concerts/index_db", concerts: @concerts_db
            = render "concerts/index_api", concerts: @concerts_api       