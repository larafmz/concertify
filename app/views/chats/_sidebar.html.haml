.sidebar{style: "height: 100%; overflow-y: auto; min-height: 0;", data: { controller: "chat-filter" }}
    = turbo_stream_from current_user, "sidebar"
    %div{id: "chat_sidebar", style: "margin:15px 15px 5px 20px;"}
        = form_tag chats_path, method: "GET" do
            = text_field_tag :search, params[:search], placeholder: t("search"), class: "field-custom", data: { chat_filter_target: "input", action: "input->chat-filter#filter" }
        %div{style: "margin:15px 0px 5px 10px;"}
            - puts "AQUI"
            - puts chats.joins(:chat_entries).where(chat_entries: { chat_type: 0 }).group("chats.id").order(Arel.sql("MAX(chat_entries.created_at) DESC, chats.id DESC")).pluck(:id)
            - chats.each do |chat|
                - color = chat.has_notification?(current_user) ? "white" : "#a4b3c4"
                - chat_name = chat.name(current_user).downcase
                .wrapper{data: { chat_filter_target: "chat", chat_name: chat_name }}
                    = link_to chat_path(chat), data: { turbo_frame: "chat_content", turbo_prefetch: false }, class: "diary-link" do 
                        - last_message = chat.messages.order(created_at: :desc).first
                        .artist-info{style: "grid-template-columns: auto 1fr auto; gap: 15px; margin: 5px;"}
                            .link_icon{style: "height: 50px; width: 50px;"}
                                -  photo = chat.photo(current_user)
                                = image_tag photo if photo.present?
                            .artist-name 
                                %div{style: "font-size:15px; color: #{color}"}= chat_name
                                - if last_message.present?
                                    - if last_message&.user_id == current_user.id
                                        %div{style: "font-size:12px; color: #{color}"}= t("sent")
                                    - else
                                        %div{style: "font-size:12px; color: #{color}"}= last_message.text.truncate(30)
                                    - if chat.group_chat? 
                                        .softest-color{ style: "font-size: 12px; margin-bottom:5px" }
                                            %div= "📍#{chat.event.ubication&.complete_name} "
                                            %div= "🗓️ #{formatted_event_date(chat.event.date, chat.event.start_time)}"  
                            - if last_message.present?
                                %div{style: "font-size:12px; color: #{color}"}=short_time_ago(last_message.created_at)
                    .separator