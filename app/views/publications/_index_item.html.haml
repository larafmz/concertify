- feed = publication
- publication = publication[:publication] if publication[:publication].present?

.publication-card{id: "publication-#{publication.id}"}

  - if feed[:repost]
    .publication-repost
      %span.publication-repost-icon ↻
      - if feed[:repost].user.id == current_user.id
        %span= t("verbs.you_reposted")
      - else
        %span= "#{feed[:repost].user.username} #{t("verbs.reposted").downcase}"

  .publication-main

    .publication-header

      = link_to user_path(publication.user), class: "publication-avatar-link" do
        .link_icon{style: "background: #1e2731"}
          - if publication.user.icon.attached?
            = image_tag publication.user.icon
          - else
            = publication.user.username.first.upcase

      .publication-meta
        .publication-user-line
          = link_to user_path(publication.user), class: "publication-username" do
            = publication.user.username

          - if publication.artist
            = link_to publications_artist_path(publication.artist), class: "publication-tag artist-color" do
              = publication.artist.name

          - if publication.event
            = link_to publications_event_path(publication.event), class: "publication-tag publication-tag-event event-color" do
              = publication.event.tour_name

        .publication-time= custom_time_ago_in_words(publication.created_at)

      - if can?(:destroy, publication)
        .dropdown
          %button.dropdown-button{type: "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false"} ⁝
          %ul.dropdown-menu
            %li
              - if destroy_redirect
                = button_to t("verbs.destroy"), publication_path(publication), method: :delete, data: { turbo_confirm: t("registers.destroy_message"), turbo: false }, class: "dropdown-item", id: "destroy_publication_#{publication.id}"
              - else
                = link_to t("verbs.destroy"), publication_path(publication), data: { turbo_method: :delete, turbo_confirm: t("messages.destroy_confirmation") }, class: "dropdown-item", id: "destroy_publication_#{publication.id}"

    = link_to comments_interactuable_path(publication), class: "publication-content-link" do
      .publication-text
        = simple_format(publication.review)

    - if publication.photos.attached?
      .publication-photos
        - publication.photos.each do |photo|
          = link_to rails_blob_path(photo, disposition: "inline"), target: "_blank", rel: "noopener", class: "publication-photo-link" do
            .publication-photo
              = image_tag photo

    .publication-footer
      = render "interactuables/footer", interactuable: publication