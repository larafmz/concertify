- register = Register.find_by(user_id: current_user&.id, event_id: event.id)
- future_assistance = FutureAssistance.find_by(user_id: current_user&.id, event_id: event.id )
- event_date_status = time_status(event.date, event.start_time)
- if current_user
    .button-event
        - if event_date_status == "past"
            - if !register
                = link_to t("registers.assisted"), new_register_path(event_id: event["id"]), class: "btn-custom-orange", data: { turbo_frame: "modal" }
            - else
                = link_to t("my_model", model: Register.singular), interactuable_path(id: register.id), class: "btn-custom", style: "height: auto;"
        - else
            - if !future_assistance
                = link_to t("registers.will_assist"), new_future_assistance_path(event_id: event["id"]), class: "btn-custom-orange", data: { turbo_frame: "modal" }
            - else
                = link_to t("my_model", model: FutureAssistance.singular), future_assistances_user_path(current_user&.id), class: "btn-custom", style: "height: auto;"
        - if future_assistance || register
            = link_to t("access_chat"), chat_path(event_id: event.id), class: "btn-standard-orange"

