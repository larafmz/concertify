- if registers.empty?
  %div{style: "padding-top: 15px;"}
    = render "common/empty_list_message", model: Register

.registers-grid
  - registers.each do |register|
    - feed = register
    - register = register[:register] if register[:register].present?

    .register-card-wrapper

      - if feed[:repost]
        .register-repost
          = link_to user_path(feed[:repost].user), class: "register-repost-link" do
            %span.register-repost-icon 🗘
            %span= feed[:repost].user.username
            %span.register-repost-text= t("verbs.reposted").downcase

      = link_to interactuable_path(register), class: "register-card" do

        .register-card-image
          - if register.event.get_photo.present?
            = image_tag register.event.get_photo
          - else
            .register-image-placeholder
              🎵

        .register-card-body

          .register-user
            - if register.user.icon.attached?
              = image_tag register.user.icon
            - else
              .register-user-placeholder
                = register.user.username.first.upcase

            %span= register.user.username

          .register-event-name
            = register.event.tour_name

          .register-meta
            %span.register-rating
              = register.get_rating
              - if register.review.present?
                %span.review-symbol Ξ

            %span.register-date
              = short_date(register.created_at)